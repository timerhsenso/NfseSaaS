+        // ContratoDocumentoFileStore.ExcluirPastaContrato.
+        builder.HasOne<Contrato>()
+            .WithMany()
+            .HasForeignKey(d => d.ContratoId)
+            .OnDelete(DeleteBehavior.Cascade);
+    }
+}
