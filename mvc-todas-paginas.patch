+++ b/src/NfseSaaS.Web/Views/Clientes/Index.cshtml
@@ -0,0 +1,123 @@
+@{
+    ViewData["Title"] = "Clientes";
+    var podeEditar = User.IsInRole("Administrador");
+}
+
+<div class="card mb-3">
+    <div class="card-body">
+        <label class="form-label">Empresa</label>
+        <select id="seletor-empresa" class="form-select"></select>
+    </div>
+</div>
+
+<div class="card">
+    <div class="card-header d-flex justify-content-between align-items-center">
+        <span>Clientes cadastrados</span>
+        @if (podeEditar)
+        {
+            <button type="button" class="btn btn-primary btn-sm" id="btn-novo-cliente">
+                <i class="bi bi-plus-lg"></i> Novo cliente
+            </button>
+        }
+    </div>
+    <div class="card-body">
+        <table id="tabela-clientes" class="table table-striped table-bordered w-100">
+            <thead>
+                <tr>
+                    <th>Nome</th>
+                    <th>CPF/CNPJ</th>
+                    <th>Município (IBGE)</th>
+                    <th>Situação</th>
+                    @if (podeEditar)
+                    {
+                        <th>Ações</th>
+                    }
+                </tr>
+            </thead>
+        </table>
+    </div>
+</div>
+
+@if (podeEditar)
+{
+    <div class="modal fade" id="modal-cliente" tabindex="-1">
+        <div class="modal-dialog modal-lg">
+            <div class="modal-content">
+                <form id="form-cliente">
+                    <div class="modal-header">
+                        <h5 class="modal-title" id="titulo-modal-cliente">Novo cliente</h5>
+                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
+                    </div>
+                    <div class="modal-body">
+                        <div id="erro-cliente" class="alert alert-danger d-none"></div>
+                        <input type="hidden" id="clienteId" />
+
+                        <div class="row">
+                            <div class="col-md-4 mb-3">
+                                <label class="form-label">CPF/CNPJ</label>
+                                <input type="text" class="form-control" id="cpfCnpj" maxlength="14" required placeholder="Somente números" />
+                            </div>
+                            <div class="col-md-8 mb-3">
+                                <label class="form-label">Nome</label>
+                                <input type="text" class="form-control" id="nome" maxlength="200" required />
+                            </div>
+                        </div>
+                        <div class="row">
+                            <div class="col-md-6 mb-3">
+                                <label class="form-label">E-mail</label>
+                                <input type="email" class="form-control" id="email" />
+                            </div>
+                            <div class="col-md-6 mb-3">
+                                <label class="form-label">Telefone</label>
+                                <input type="text" class="form-control" id="telefone" maxlength="20" />
+                            </div>
+                        </div>
+
+                        <h6 class="text-muted">Endereço</h6>
+                        <div class="row">
+                            <div class="col-md-3 mb-3">
+                                <label class="form-label">Município (código IBGE)</label>
+                                <input type="text" class="form-control" id="codigoMunicipio" maxlength="7" required />
+                            </div>
+                            <div class="col-md-3 mb-3">
+                                <label class="form-label">CEP</label>
+                                <input type="text" class="form-control" id="cep" maxlength="8" required placeholder="Somente números" />
+                            </div>
+                            <div class="col-md-4 mb-3">
+                                <label class="form-label">Logradouro</label>
+                                <input type="text" class="form-control" id="logradouro" maxlength="200" required />
+                            </div>
+                            <div class="col-md-2 mb-3">
+                                <label class="form-label">Número</label>
+                                <input type="text" class="form-control" id="numero" maxlength="20" required />
+                            </div>
+                        </div>
+                        <div class="row">
+                            <div class="col-md-5 mb-3">
+                                <label class="form-label">Complemento</label>
+                                <input type="text" class="form-control" id="complemento" maxlength="100" />
+                            </div>
+                            <div class="col-md-5 mb-3">
+                                <label class="form-label">Bairro</label>
+                                <input type="text" class="form-control" id="bairro" maxlength="100" required />
+                            </div>
+                            <div class="col-md-2 mb-3">
+                                <label class="form-label">UF</label>
+                                <input type="text" class="form-control" id="uf" maxlength="2" required placeholder="BA" />
+                            </div>
+                        </div>
+                    </div>
+                    <div class="modal-footer">
+                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
+                        <button type="submit" class="btn btn-primary">Salvar</button>
+                    </div>
+                </form>
+            </div>
+        </div>
+    </div>
+}
+
+@section Scripts {
+    <script src="~/js/empresa-seletor.js"></script>
+    <script src="~/js/paginas/clientes.js"></script>
+}
diff --git a/src/NfseSaaS.Web/Views/Nfse/Index.cshtml b/src/NfseSaaS.Web/Views/Nfse/Index.cshtml
new file mode 100644
index 0000000..82bd067
--- /dev/null
+++ b/src/NfseSaaS.Web/Views/Nfse/Index.cshtml
@@ -0,0 +1,150 @@
+@{
+    ViewData["Title"] = "Notas Fiscais";
+    var podeEmitir = User.IsInRole("Administrador") || User.IsInRole("Emissor");
+    var podeCancelar = User.IsInRole("Administrador");
+}
+
+<div class="card mb-3">
+    <div class="card-body">
+        <label class="form-label">Empresa</label>
+        <select id="seletor-empresa" class="form-select"></select>
+    </div>
+</div>
+
+<div class="card">
+    <div class="card-header d-flex justify-content-between align-items-center">
+        <span>Notas fiscais emitidas</span>
+        @if (podeEmitir)
+        {
+            <button type="button" class="btn btn-primary btn-sm" id="btn-emitir-nfse">
+                <i class="bi bi-plus-lg"></i> Emitir nota
+            </button>
+        }
+    </div>
+    <div class="card-body">
+        <table id="tabela-nfse" class="table table-striped table-bordered w-100">
+            <thead>
+                <tr>
+                    <th>Número/Série</th>
+                    <th>Cliente</th>
+                    <th>Valor</th>
+                    <th>Valor líquido</th>
+                    <th>Status</th>
+                    <th>Emissão</th>
+                    <th>Ações</th>
+                </tr>
+            </thead>
+        </table>
+    </div>
+</div>
+
+@if (podeEmitir)
+{
+    <!-- Modal de emissão -->
+    <div class="modal fade" id="modal-emitir-nfse" tabindex="-1">
+        <div class="modal-dialog">
+            <div class="modal-content">
+                <form id="form-emitir-nfse">
+                    <div class="modal-header">
+                        <h5 class="modal-title">Emitir nota fiscal</h5>
+                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
+                    </div>
+                    <div class="modal-body">
+                        <div id="erro-emitir-nfse" class="alert alert-danger d-none"></div>
+
+                        <div class="mb-3">
+                            <label class="form-label">Cliente</label>
+                            <select class="form-select" id="emitir-clienteId" required></select>
+                        </div>
+                        <div class="mb-3">
+                            <label class="form-label">Serviço</label>
+                            <select class="form-select" id="emitir-servicoId" required></select>
+                        </div>
+                        <div class="mb-3">
+                            <label class="form-label">Descrição do serviço nesta nota</label>
+                            <input type="text" class="form-control" id="emitir-descricaoServico" maxlength="2000" required />
+                        </div>
+                        <div class="row">
+                            <div class="col-md-6 mb-3">
+                                <label class="form-label">Valor do serviço</label>
+                                <input type="number" step="0.01" min="0.01" class="form-control" id="emitir-valorServico" required />
+                            </div>
+                            <div class="col-md-6 mb-3">
+                                <label class="form-label">Competência</label>
+                                <input type="date" class="form-control" id="emitir-dataCompetencia" required />
+                            </div>
+                        </div>
+                    </div>
+                    <div class="modal-footer">
+                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
+                        <button type="submit" class="btn btn-primary" id="btn-confirmar-emissao">Emitir</button>
+                    </div>
+                </form>
+            </div>
+        </div>
+    </div>
+}
+
+<!-- Modal de detalhe: status, eventos (NfseEvento) e snapshot fiscal -->
+<div class="modal fade" id="modal-detalhe-nfse" tabindex="-1">
+    <div class="modal-dialog modal-lg">
+        <div class="modal-content">
+            <div class="modal-header">
+                <h5 class="modal-title">Detalhe da nota</h5>
+                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
+            </div>
+            <div class="modal-body">
+                <dl class="row" id="detalhe-nfse-dados"></dl>
+
+                <h6 class="text-muted mt-3">Histórico de eventos</h6>
+                <ul class="list-group mb-3" id="detalhe-nfse-eventos"></ul>
+
+                <h6 class="text-muted">Snapshot fiscal (contexto da emissão)</h6>
+                <pre id="detalhe-nfse-snapshot" class="bg-body-tertiary p-2 rounded small"></pre>
+            </div>
+            <div class="modal-footer">
+                @if (podeCancelar)
+                {
+                    <button type="button" class="btn btn-outline-danger" id="btn-cancelar-nfse">Cancelar nota</button>
+                }
+                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
+            </div>
+        </div>
+    </div>
+</div>
+
+@if (podeCancelar)
+{
+    <div class="modal fade" id="modal-motivo-cancelamento" tabindex="-1">
+        <div class="modal-dialog">
+            <div class="modal-content">
+                <form id="form-cancelar-nfse">
+                    <div class="modal-header">
+                        <h5 class="modal-title">Cancelar nota fiscal</h5>
+                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
+                    </div>
+                    <div class="modal-body">
+                        <div id="erro-cancelar-nfse" class="alert alert-danger d-none"></div>
+                        <div class="mb-3">
+                            <label class="form-label">Código do motivo (tabela oficial da SEFIN)</label>
+                            <input type="number" class="form-control" id="codigoMotivoCancelamento" required />
+                        </div>
+                        <div class="mb-3">
+                            <label class="form-label">Motivo</label>
+                            <textarea class="form-control" id="motivoCancelamento" maxlength="255" required></textarea>
+                        </div>
+                    </div>
+                    <div class="modal-footer">
+                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>
+                        <button type="submit" class="btn btn-danger">Confirmar cancelamento</button>
+                    </div>
+                </form>
+            </div>
+        </div>
+    </div>
+}
+
+@section Scripts {
+    <script src="~/js/empresa-seletor.js"></script>
+    <script src="~/js/paginas/nfse.js"></script>
+}
