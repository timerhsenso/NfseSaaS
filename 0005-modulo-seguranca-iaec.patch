+    <div class="modal-dialog modal-lg">
+        <div class="modal-content">
+            <div class="modal-header">
+                <h5 class="modal-title">Permissões de <span id="matriz-grupo-nome"></span></h5>
+                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
+            </div>
+            <div class="modal-body">
+                <div id="matriz-aviso-admin" class="alert alert-info d-none">
+                    O grupo Administrador sempre tem acesso total — não é possível editar esta matriz.
+                </div>
+                <table class="table table-sm table-bordered align-middle" id="tabela-matriz">
+                    <thead>
+                        <tr>
+                            <th>Tela</th>
+                            <th class="text-center">Incluir</th>
+                            <th class="text-center">Alterar</th>
+                            <th class="text-center">Excluir</th>
+                            <th class="text-center">Consultar</th>
+                        </tr>
+                    </thead>
+                    <tbody id="matriz-corpo"></tbody>
+                </table>
+            </div>
+            <div class="modal-footer">
+                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
+                <button type="button" class="btn btn-primary" id="btn-salvar-matriz">Salvar permissões</button>
+            </div>
+        </div>
+    </div>
+</div>
+
+@section Scripts {
+    <script>
+        window.__gruposPermissoes = {
+            podeAlterar: @Html.Raw(podeAlterar.ToString().ToLowerInvariant()),
+            podeExcluir: @Html.Raw(podeExcluir.ToString().ToLowerInvariant())
+        };
+    </script>
+    <script src="~/js/paginas/grupos.js" asp-append-version="true"></script>
+}
