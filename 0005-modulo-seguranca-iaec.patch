+    var podeIncluir = User.PodeIncluir(NfseSaaS.Application.Authorization.TelaCatalogo.Grupos);
+    var podeAlterar = User.PodeAlterar(NfseSaaS.Application.Authorization.TelaCatalogo.Grupos);
+    var podeExcluir = User.PodeExcluir(NfseSaaS.Application.Authorization.TelaCatalogo.Grupos);
+}
+
+<div class="card">
+    <div class="card-header d-flex justify-content-between align-items-center">
+        <span>Grupos de permissão</span>
+        @if (podeIncluir)
+        {
+            <button type="button" class="btn btn-primary btn-sm" id="btn-novo-grupo">
+                <i class="bi bi-plus-lg"></i> Novo grupo
+            </button>
+        }
+    </div>
+    <div class="card-body">
+        <table id="tabela-grupos" class="table table-striped table-bordered w-100">
+            <thead>
+                <tr>
+                    <th>Nome</th>
+                    <th>Descrição</th>
+                    <th>Usuários</th>
+                    <th>Origem</th>
+                    <th>Ações</th>
+                </tr>
+            </thead>
+        </table>
+    </div>
+</div>
+
+<div class="modal fade" id="modal-grupo" tabindex="-1">
+    <div class="modal-dialog">
+        <div class="modal-content">
+            <form id="form-grupo">
+                <div class="modal-header">
+                    <h5 class="modal-title" id="titulo-modal-grupo">Novo grupo</h5>
+                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
+                </div>
+                <div class="modal-body">
+                    <div id="erro-grupo" class="alert alert-danger d-none"></div>
+                    <input type="hidden" id="grupoId" />
+                    <div class="mb-3">
+                        <label class="form-label">Nome</label>
+                        <input type="text" class="form-control" id="grupoNome" maxlength="100" required />
+                    </div>
+                    <div class="mb-3">
+                        <label class="form-label">Descrição</label>
+                        <textarea class="form-control" id="grupoDescricao" maxlength="500" rows="2"></textarea>
+                    </div>
+                </div>
+                <div class="modal-footer">
+                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
+                    <button type="submit" class="btn btn-primary">Salvar</button>
+                </div>
+            </form>
+        </div>
+    </div>
+</div>
+
