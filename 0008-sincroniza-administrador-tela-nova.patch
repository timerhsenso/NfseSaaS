+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using NfseSaaS.Domain.Entities;
+
+namespace NfseSaaS.Infrastructure.Persistence.Seeders;
+
+/// <summary>
+/// Garante que o grupo Administrador (Grupo.EhAdministrador) de TODO
+/// Tenant tem acesso total (IAEC completo) a TODA Tela do catálogo
+/// atual — roda em todo boot, idempotente. Sem isto, uma Tela nova
+/// (adicionada em TelaCatalogo depois que o Tenant já tinha seus Grupos
+/// provisionados) ficaria invisível até pro Administrador, sem nenhuma
+/// forma de habilitar pela própria UI — a matriz do grupo Administrador
+/// é bloqueada pra edição de propósito (ver
+/// GruposController.AtualizarPermissoes), então precisa de um caminho
+/// de sistema separado pra isso.
+/// </summary>
+public static class AdministradorTelaSeeder
+{
+    public static async Task SincronizarAsync(IServiceProvider services)
+    {
+        using var scope = services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+
+        var telas = await db.Telas.AsNoTracking().ToListAsync();
+        if (telas.Count == 0)
+            return;
+
+        var gruposAdministrador = await db.Grupos.IgnoreQueryFilters()
+            .Where(g => g.EhAdministrador)
+            .ToListAsync();
+
+        // Um SaveChanges por Grupo (não um só pro lote inteiro) de
+        // propósito: TenantIdOverrideDeSistema (ver AppDbContext) só
+        // segura UM tenant por vez — os grupos Administrador aqui são de
+        // Tenants DIFERENTES, então misturar tudo numa gravação só
+        // corromperia o TenantId de quem não é o override ativo.
+        foreach (var grupo in gruposAdministrador)
+        {
+            var permissoesExistentes = await db.GrupoTelas.IgnoreQueryFilters()
+                .Where(gt => gt.GrupoId == grupo.Id)
+                .ToDictionaryAsync(gt => gt.TelaId);
+
+            var precisaGravar = false;
+
+            db.TenantIdOverrideDeSistema = grupo.TenantId;
+            try
+            {
+                foreach (var tela in telas)
+                {
+                    if (permissoesExistentes.TryGetValue(tela.Id, out var linha))
+                    {
+                        if (!linha.Incluir || !linha.Alterar || !linha.Excluir || !linha.Consultar)
+                        {
+                            linha.Incluir = linha.Alterar = linha.Excluir = linha.Consultar = true;
+                            precisaGravar = true;
+                        }
+                    }
+                    else
+                    {
+                        db.GrupoTelas.Add(new GrupoTela
+                        {
+                            TenantId = grupo.TenantId,
+                            GrupoId = grupo.Id,
+                            TelaId = tela.Id,
+                            Incluir = true,
+                            Alterar = true,
+                            Excluir = true,
+                            Consultar = true
+                        });
+                        precisaGravar = true;
+                    }
+                }
+
+                if (precisaGravar)
+                    await db.SaveChangesAsync();
+            }
+            finally
+            {
+                db.TenantIdOverrideDeSistema = null;
+            }
+        }
+    }
+}
