+
+        var nomeArquivo = MontarNomeArquivo(clienteNome, nfse.NumeroDps, nfse.DataEmissao ?? new DateTimeOffset(nfse.DataCompetencia.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero));
