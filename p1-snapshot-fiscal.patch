diff --git a/src/NfseSaaS.Infrastructure/UseCases/ObterSnapshotFiscalDaNfseUseCase.cs b/src/NfseSaaS.Infrastructure/UseCases/ObterSnapshotFiscalDaNfseUseCase.cs
