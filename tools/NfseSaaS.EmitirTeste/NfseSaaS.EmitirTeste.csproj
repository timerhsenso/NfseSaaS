<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>NfseSaaS.EmitirTeste</RootNamespace>
	</PropertyGroup>

	<!--
    Ferramenta manual (NÃO faz parte do dotnet test) para emitir uma DPS de
    teste através da arquitetura definitiva (NfseSaaS.Nacional), usando o
    certificado real já cadastrado via NfseSaaS.CertTool. Reproduz a mesma
    emissão que a POC validou (HTTP 201), agora pela arquitetura do SaaS.
  -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\NfseSaaS.Nacional\NfseSaaS.Nacional.csproj" />
		<ProjectReference Include="..\..\src\NfseSaaS.Infrastructure\NfseSaaS.Infrastructure.csproj" />
	</ItemGroup>

</Project>