<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>NfseSaaS.CertTool</RootNamespace>
	</PropertyGroup>

	<!--
    Ferramenta de linha de comando para cadastrar o certificado .pfx de uma
    Empresa no armazenamento criptografado (CertificateFileStore, em
    NfseSaaS.Infrastructure). Roda localmente no servidor, fora do Web —
    evita expor um endpoint HTTP de upload de certificado, mesmo que
    temporário.
  -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\NfseSaaS.Infrastructure\NfseSaaS.Infrastructure.csproj" />
	</ItemGroup>

</Project>