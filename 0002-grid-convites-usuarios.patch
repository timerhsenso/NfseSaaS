@@ -0,0 +1,120 @@
+let tabelaConvites;
+
+document.addEventListener('DOMContentLoaded', function () {
+    tabelaConvites = new DataTable('#tabela-convites', {
+        columns: [
+            { data: 'email' },
+            { data: 'papel' },
+            { data: 'convidadoEm', render: v => new Date(v).toLocaleDateString('pt-BR') },
+            {
+                data: 'aceito',
+                render: (aceito, type, convite) => aceito
+                    ? `<span class="badge text-bg-success" title="Aceito em ${new Date(convite.conviteAceitoEm).toLocaleDateString('pt-BR')}">Aceito</span>`
+                    : '<span class="badge text-bg-warning">Pendente</span>'
+            },
+            {
+                data: null,
+                orderable: false,
+                render: (data, type, convite) => convite.aceito
+                    ? '—'
+                    : `
+                        <button type="button" class="btn btn-sm btn-outline-primary btn-reenviar" data-id="${convite.id}" title="Reenviar e-mail de convite">
+                            <i class="bi bi-envelope-arrow-up"></i>
+                        </button>
+                        <button type="button" class="btn btn-sm btn-outline-danger btn-excluir-convite" data-id="${convite.id}" title="Excluir convite">
+                            <i class="bi bi-trash"></i>
+                        </button>
+                    `
+            }
+        ],
+        order: [[2, 'desc']],
+        language: { url: 'https://cdn.datatables.net/plug-ins/2.1.8/i18n/pt-BR.json' }
+    });
+
+    document.getElementById('tabela-convites').addEventListener('click', async function (e) {
+        const botao = e.target.closest('button');
+        if (!botao) return;
+        const id = botao.dataset.id;
+
+        if (botao.classList.contains('btn-reenviar')) await reenviarConvite(id);
+        else if (botao.classList.contains('btn-excluir-convite')) await excluirConvite(id);
+    });
+
+    document.getElementById('form-convite').addEventListener('submit', convidar);
+
+    carregarConvites();
+});
+
+async function carregarConvites() {
+    try {
+        const convites = await apiFetch('/api/auth/convites');
+        tabelaConvites.clear();
+        tabelaConvites.rows.add(convites);
+        tabelaConvites.draw();
+    } catch (err) {
+        mostrarErro(err.message);
+    }
+}
+
+async function convidar(e) {
+    e.preventDefault();
+    const erroDiv = document.getElementById('erro-convite');
+    const sucessoDiv = document.getElementById('sucesso-convite');
+    erroDiv.classList.add('d-none');
+    sucessoDiv.classList.add('d-none');
+
+    try {
+        const resultado = await apiFetch('/api/auth/convidar', {
+            method: 'POST',
+            body: JSON.stringify({
+                email: document.getElementById('email').value,
+                papel: document.getElementById('papel').value
+            })
+        });
+
+        let mensagem = `Convite enviado para ${resultado.email}.`;
+        if (!resultado.emailEnviado) {
+            mensagem += ` O e-mail não pôde ser enviado — token de aceite: ${resultado.token}`;
+        }
+
+        sucessoDiv.textContent = mensagem;
+        sucessoDiv.classList.remove('d-none');
+        document.getElementById('form-convite').reset();
+
+        await carregarConvites();
+    } catch (err) {
+        erroDiv.textContent = err.message;
+        erroDiv.classList.remove('d-none');
+    }
+}
+
+async function reenviarConvite(id) {
+    try {
+        const resultado = await apiFetch(`/api/auth/convites/${id}/reenviar`, { method: 'POST' });
+
+        let mensagem = `Convite reenviado para ${resultado.email}.`;
+        if (!resultado.emailEnviado) {
+            mensagem += ` O e-mail não pôde ser enviado — token de aceite: ${resultado.token}`;
+        }
+
+        mostrarToast(mensagem);
+    } catch (err) {
+        mostrarErro(err.message);
+    }
+}
+
+async function excluirConvite(id) {
+    const confirmado = await confirmarAcao(
+        'Excluir este convite? Só funciona se ele ainda não tiver sido aceito.',
+        { titulo: 'Excluir convite', textoBotao: 'Excluir', variante: 'perigo' }
+    );
+    if (!confirmado) return;
+
+    try {
+        await apiFetch(`/api/auth/convites/${id}`, { method: 'DELETE' });
+        await carregarConvites();
+        mostrarToast('Convite excluído.');
+    } catch (err) {
+        mostrarErro(err.message);
+    }
+}
