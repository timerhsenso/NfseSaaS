+/*
+ * Tema claro e visual profissional do NfseSaaS.
+ *
+ * O AdminLTE 4 segue o "prefers-color-scheme" do sistema/navegador por
+ * padrão (via Bootstrap 5.3) — em qualquer máquina com dark mode ativado
+ * no Windows/navegador, a tela inteira ficava escura sem que o usuário
+ * tivesse escolhido isso. O html/body agora força data-bs-theme="light"
+ * (ver _Layout.cshtml / _AuthLayout.cshtml); este arquivo cuida do
+ * polimento visual por cima disso — cores, espaçamento, cantos
+ * arredondados, sombra suave.
+ */
+
+:root {
+    --nfse-primary: #2952e3;
+    --nfse-primary-dark: #1e3fc4;
+    --nfse-bg: #f4f6fb;
+    --nfse-card-border: #e9ecf2;
+    --nfse-sidebar-bg: #101a33;
+    --nfse-sidebar-active: #2952e3;
+    --nfse-text-muted: #6b7280;
+    --nfse-radius: 0.6rem;
+}
+
 body {
-    background-color: #f8f9fa;
+    background-color: var(--nfse-bg);
+    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+    color: #1f2430;
+}
+
+/* ---- Cabeçalho ---- */
+
+.app-header {
+    background-color: #fff;
+    border-bottom: 1px solid var(--nfse-card-border);
+}
+
+.app-content-header {
+    padding: 1.25rem 0 0.5rem;
+}
+
+.app-content-header h3 {
+    font-weight: 600;
+    color: #1f2430;
+}
+
+/* ---- Sidebar ---- */
+
+.app-sidebar {
+    background-color: var(--nfse-sidebar-bg) !important;
+}
+
+.app-sidebar .sidebar-brand {
+    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+.app-sidebar .brand-link {
+    color: #fff;
+    text-decoration: none;
+    display: flex;
+    align-items: center;
+}
+
+.app-sidebar .nav-sidebar > .nav-item > .nav-link {
+    border-radius: var(--nfse-radius);
+    margin: 0.15rem 0.6rem;
+    color: rgba(255, 255, 255, 0.75);
+    transition: background-color 0.15s ease, color 0.15s ease;
+}
+
+.app-sidebar .nav-sidebar > .nav-item > .nav-link:hover {
+    background-color: rgba(255, 255, 255, 0.08);
+    color: #fff;
+}
+
+.app-sidebar .nav-sidebar > .nav-item > .nav-link.active {
+    background-color: var(--nfse-sidebar-active);
+    color: #fff;
+}
+
+/* ---- Cards ---- */
+
+.card {
+    border: 1px solid var(--nfse-card-border);
+    border-radius: var(--nfse-radius);
+    box-shadow: 0 1px 3px rgba(16, 26, 51, 0.06);
+}
+
+.card-header {
+    background-color: #fff;
+    border-bottom: 1px solid var(--nfse-card-border);
+    font-weight: 600;
+    border-top-left-radius: var(--nfse-radius);
+    border-top-right-radius: var(--nfse-radius);
+}
+
+/* ---- Botões ---- */
+
+.btn {
+    border-radius: 0.5rem;
+    font-weight: 500;
+    padding-inline: 0.9rem;
+}
+
+.btn-primary {
+    background-color: var(--nfse-primary);
+    border-color: var(--nfse-primary);
+}
+
+.btn-primary:hover,
+.btn-primary:focus {
+    background-color: var(--nfse-primary-dark);
+    border-color: var(--nfse-primary-dark);
+}
+
+.btn-sm {
+    border-radius: 0.45rem;
+}
+
+/* Botões de exportação (DataTables Buttons) — mesmo padrão visual dos
+   outros botões da tela, em vez do estilo padrão da extensão. */
+.dt-buttons .btn {
+    border-radius: 0.45rem;
+    font-size: 0.8rem;
+    padding: 0.3rem 0.7rem;
+}
+
+/* ---- Tabelas / DataTables ---- */
+
+table.dataTable thead th {
+    font-weight: 600;
+    font-size: 0.8rem;
+    text-transform: uppercase;
+    letter-spacing: 0.02em;
+    color: var(--nfse-text-muted);
+    border-bottom: 2px solid var(--nfse-card-border);
+}
+
+table.dataTable tbody tr:hover {
+    background-color: #f0f3fb;
+}
+
+table.dataTable td,
+table.dataTable th {
+    vertical-align: middle;
+}
+
+.badge {
+    font-weight: 500;
+    padding: 0.4em 0.7em;
+    border-radius: 0.4rem;
+}
+
+/* ---- Formulários ---- */
+
+.form-label {
+    font-weight: 500;
+    font-size: 0.85rem;
+    color: #374151;
+}
+
+.form-control,
+.form-select {
+    border-radius: 0.5rem;
+    border-color: #d7dbe4;
+}
+
+.form-control:focus,
+.form-select:focus {
+    border-color: var(--nfse-primary);
+    box-shadow: 0 0 0 0.2rem rgba(41, 82, 227, 0.15);
+}
+
+/* ---- Autenticação (login/registro/convite) ---- */
+
+.auth-page {
+    background: linear-gradient(160deg, #eef1fb 0%, var(--nfse-bg) 55%);
+}
+
+.auth-card {
+    border-radius: 1rem;
+}
+
+/* ---- Rodapé de auditoria injetado na impressão (ver exportacao.js) ---- */
+
+.rodape-exportacao {
+    margin-top: 1.5rem;
+    padding-top: 0.6rem;
+    border-top: 1px solid #ccc;
+    font-size: 0.75rem;
+    color: #666;
 }
diff --git a/src/NfseSaaS.Web/wwwroot/js/exportacao.js b/src/NfseSaaS.Web/wwwroot/js/exportacao.js
new file mode 100644
index 0000000..bde7bc9
--- /dev/null
+++ b/src/NfseSaaS.Web/wwwroot/js/exportacao.js
@@ -0,0 +1,78 @@
+/**
+ * Adiciona botões de Copiar/CSV/Excel/Imprimir a um DataTable já
+ * inicializado, seguindo 2 exigências:
+ *
+ * 1. Toda exportação/impressão sai com um rodapé mostrando quem
+ *    exportou e quando (data/hora do NAVEGADOR do usuário, no momento
+ *    do clique — não precisa bater no servidor pra isso).
+ * 2. Toda exportação/impressão é registrada no AuditLog do backend
+ *    (POST /api/exportacoes) — é só o METADADO (tela + formato), nunca
+ *    o conteúdo da grid; ver ExportacoesController.
+ *
+ * Uso: depois de `new DataTable('#minhaTabela', {...})`, chama
+ * `configurarExportacao(tabela, 'Empresas')`.
+ */
+function configurarExportacao(tabela, nomeTela) {
+    const linhaRodape = () => `Exportado por ${window.usuarioAtual ?? 'desconhecido'} em ${new Date().toLocaleString('pt-BR')}`;
+    const nomeArquivo = () => `${nomeTela}_${new Date().toISOString().slice(0, 10)}`;
+
+    new $.fn.dataTable.Buttons(tabela, {
+        buttons: [
+            {
+                extend: 'copyHtml5',
+                text: '<i class="bi bi-clipboard"></i> Copiar'
+            },
+            {
+                extend: 'csvHtml5',
+                text: '<i class="bi bi-filetype-csv"></i> CSV',
+                filename: nomeArquivo,
+                customizeData: function (data) {
+                    data.body.push([linhaRodape()]);
+                }
+            },
+            {
+                extend: 'excelHtml5',
+                text: '<i class="bi bi-file-earmark-excel"></i> Excel',
+                filename: nomeArquivo,
+                customizeData: function (data) {
+                    data.body.push([linhaRodape()]);
+                }
+            },
+            {
+                extend: 'print',
+                text: '<i class="bi bi-printer"></i> Imprimir',
+                title: nomeTela,
+                customize: function (win) {
+                    $(win.document.body).append(`<div class="rodape-exportacao">${linhaRodape()}</div>`);
+                }
+            }
+        ]
+    });
+
+    // Container padrão dos botões — a própria extensão gera um <div
+    // class="dt-buttons">; só precisamos colocá-lo em algum lugar
+    // visível da tela. O elemento com id "botoes-exportacao-<tabela>"
+    // deve existir na view (uma div vazia no card-header, por
+    // convenção) — se não existir, os botões ficam soltos no início
+    // do body (comportamento padrão da extensão), então prefira sempre
+    // criar o placeholder na view.
+    var containerId = 'botoes-exportacao-' + tabela.table().node().id;
+    var container = document.getElementById(containerId);
+    if (container) {
+        container.appendChild(tabela.buttons().container()[0]);
+    }
+
+    // Registro de auditoria — nunca bloqueia a exportação em si: se o
+    // log falhar (rede etc.), o usuário ainda consegue exportar/imprimir.
+    tabela.on('buttons-action.dt', function (e, buttonApi, dt, node, config) {
+        var formato = (config && config.extend) ? config.extend : 'desconhecido';
+        fetch('/api/exportacoes', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ tela: nomeTela, formato: formato })
+        }).catch(function (err) {
+            console.warn('Não foi possível registrar a exportação:', err);
+        });
+    });
+}
