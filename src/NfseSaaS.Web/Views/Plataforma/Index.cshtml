@{
    ViewData["Title"] = "Contas da plataforma";
}

@section AcoesPagina {
    <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-atualizar-plataforma"><i class="bi bi-arrow-clockwise"></i> Atualizar</button>
    <div class="dropdown">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="dropdown" aria-expanded="false" title="Mais ações" aria-label="Mais ações">
            <i class="bi bi-three-dots" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a href="/hangfire" class="dropdown-item" target="_blank" rel="noopener"><i class="bi bi-cpu me-2" aria-hidden="true"></i>Jobs (Hangfire)</a></li>
        </ul>
    </div>
}

<div class="stats">
    <div class="stat">
        <div class="stat-top"><span class="stat-label">Contas ativas</span><div class="stat-icon"><i class="bi bi-buildings"></i></div></div>
        <strong id="kpi-ativas">-</strong>
        <small id="kpi-ativas-detalhe">&nbsp;</small>
    </div>
    <div class="stat">
        <div class="stat-top"><span class="stat-label">Contas suspensas</span><div class="stat-icon"><i class="bi bi-pause-circle"></i></div></div>
        <strong id="kpi-suspensas">-</strong>
        <small>Sem login e sem emissão</small>
    </div>
    <div class="stat">
        <div class="stat-top"><span class="stat-label">Notas autorizadas no mês (produção)</span><div class="stat-icon"><i class="bi bi-receipt"></i></div></div>
        <strong id="kpi-notas-mes">-</strong>
        <small>Somando todas as contas</small>
    </div>
    <div class="stat">
        <div class="stat-top"><span class="stat-label">Empresas em produção</span><div class="stat-icon"><i class="bi bi-broadcast"></i></div></div>
        <strong id="kpi-producao">-</strong>
        <small id="kpi-producao-detalhe">&nbsp;</small>
    </div>
</div>

<div class="stats mt-3">
    <div class="stat">
        <div class="stat-top"><span class="stat-label">Em teste agora</span><div class="stat-icon"><i class="bi bi-hourglass-split"></i></div></div>
        <strong id="kpi-em-teste">-</strong>
        <small id="kpi-em-teste-detalhe">&nbsp;</small>
    </div>
    <div class="stat">
        <div class="stat-top"><span class="stat-label">Assinantes</span><div class="stat-icon"><i class="bi bi-credit-card"></i></div></div>
        <strong id="kpi-assinantes">-</strong>
        <small id="kpi-assinantes-detalhe">&nbsp;</small>
    </div>
    <div class="stat">
        <div class="stat-top"><span class="stat-label">Receita mensal (MRR)</span><div class="stat-icon"><i class="bi bi-cash-stack"></i></div></div>
        <strong id="kpi-mrr">-</strong>
        <small id="kpi-mrr-detalhe">Assinantes em dia e em atraso</small>
    </div>
    <div class="stat">
        <div class="stat-top"><span class="stat-label">Conversão do teste</span><div class="stat-icon"><i class="bi bi-graph-up-arrow"></i></div></div>
        <strong id="kpi-conversao">-</strong>
        <small id="kpi-conversao-detalhe">&nbsp;</small>
    </div>
    <div class="stat">
        <div class="stat-top"><span class="stat-label">Vagas de fundador</span><div class="stat-icon"><i class="bi bi-star"></i></div></div>
        <strong id="kpi-vagas">-</strong>
        <small id="kpi-vagas-detalhe">&nbsp;</small>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h6 class="mb-3">Contas (clientes do micoempresa)</h6>
        <div class="barra-lista" id="barra-tabela-tenants">
            <label class="visually-hidden" for="filtro-situacao">Filtrar contas</label>
            <select class="form-select form-select-sm" id="filtro-situacao" style="width:auto">
                <option value="">Todas as contas</option>
                <option value="teste">Em teste</option>
                <option value="teste-acabado">Teste acabado sem assinar</option>
                <option value="sem-teste">Sem teste (CNPJ já usado)</option>
                <option value="assinante">Assinantes em dia</option>
                <option value="atraso">Em atraso</option>
                <option value="cancelada">Assinatura cancelada</option>
                <option value="isenta">Isentas</option>
                <option value="suspensa">Suspensas</option>
                <option value="encerrada">Encerradas</option>
            </select>
        </div>
        <table id="tabela-tenants" class="table w-100">
            <thead>
                <tr>
                    <th>Conta</th>
                    <th>Responsável</th>
                    <th>Desde</th>
                    <th class="text-end">Usuários</th>
                    <th class="text-end">Empresas</th>
                    <th class="text-end" title="Notas autorizadas em produção (homologação não conta)">Notas no mês</th>
                    <th>Última nota</th>
                    <th>Situação</th>
                    <th>Ações</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-gift"></i> Prêmios de indicação (1 mês grátis)</span>
        <span class="small text-muted" id="resumo-premios">&nbsp;</span>
    </div>
    <div class="card-body">
        <p class="small text-muted mb-3">
            Quando uma conta indicada paga a primeira fatura, ela e quem indicou ganham 1 mês grátis: a próxima fatura
            em aberto é removida no Asaas (ou o próximo vencimento é adiado, se a fatura ainda não foi gerada).
            Quem ainda não paga fica com o prêmio guardado até assinar e pagar. A aplicação roda logo após o pagamento
            e todo dia às 07:40.
        </p>
        <table id="tabela-premios" class="table w-100">
            <thead>
                <tr>
                    <th>Desde</th>
                    <th>Quem ganha</th>
                    <th>Por causa de</th>
                    <th>Situação</th>
                    <th>Detalhe</th>
                    <th>Ações</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-shield-lock"></i> Proteção das chaves</span>
        <button type="button" class="btn btn-outline-primary btn-sm d-none" id="btn-reproteger-chaves"><i class="bi bi-shield-check"></i> Proteger chaves antigas</button>
    </div>
    <div class="card-body">
        <p class="small text-muted mb-3">
            As chaves do Data Protection abrem os certificados A1 de todos os clientes e assinam o login.
            Elas devem ficar criptografadas em disco.
        </p>
        <dl class="row mb-2 small">
            <dt class="col-sm-3">Pasta</dt>
            <dd class="col-sm-9"><code id="chaves-pasta">-</code></dd>
            <dt class="col-sm-3">Chaves novas</dt>
            <dd class="col-sm-9" id="chaves-mecanismo">-</dd>
            <dt class="col-sm-3">Chaves na pasta</dt>
            <dd class="col-sm-9" id="chaves-total">-</dd>
            <dt class="col-sm-3">Certificados guardados</dt>
            <dd class="col-sm-9" id="chaves-certificados">-</dd>
        </dl>
        <div id="chaves-orientacao" class="alert alert-secondary mb-0 small">Carregando…</div>
    </div>
</div>

<div class="modal fade" id="modal-suspender-tenant" tabindex="-1" aria-labelledby="titulo-suspender-tenant">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="form-suspender-tenant">
                <div class="modal-header">
                    <h5 class="modal-title" id="titulo-suspender-tenant">Suspender conta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div id="erro-suspender-tenant" class="alert alert-danger d-none"></div>
                    <p class="mb-3">Suspender <strong id="nome-tenant-suspender"></strong>:</p>
                    <ul class="small text-muted mb-3">
                        <li>ninguém da conta entra, e quem está logado sai em até 1 minuto;</li>
                        <li>nenhuma nota é emitida, nem pela Nota Mensal automática;</li>
                        <li>os dados ficam guardados — dá para reativar a qualquer momento.</li>
                    </ul>
                    <label class="form-label" for="motivo-suspensao">Motivo</label>
                    <input type="text" class="form-control" id="motivo-suspensao" maxlength="300" required placeholder="ex.: inadimplência desde 10/11" />
                    <div class="form-text">Só você vê. Fica registrado no histórico da conta.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Suspender conta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-encerrar-tenant" tabindex="-1" aria-labelledby="titulo-encerrar-tenant">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="form-encerrar-tenant">
                <div class="modal-header">
                    <h5 class="modal-title" id="titulo-encerrar-tenant">Encerrar conta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div id="erro-encerrar-tenant" class="alert alert-danger d-none"></div>
                    <p class="mb-3">Encerrar <strong id="nome-tenant-encerrar"></strong>:</p>
                    <ul class="small text-muted mb-3">
                        <li>a assinatura no Asaas é cancelada (se houver) e ninguém da conta entra mais;</li>
                        <li>os administradores recebem um e-mail com a data em que os dados serão apagados;</li>
                        <li>em 90 dias o job apaga os dados: sem notas, a conta inteira; com notas, tudo menos os documentos fiscais;</li>
                        <li>até lá, "Reabrir" desfaz o encerramento.</li>
                    </ul>
                    <label class="form-label" for="motivo-encerramento">Motivo</label>
                    <input type="text" class="form-control" id="motivo-encerramento" maxlength="250" required placeholder="ex.: pedido do cliente por e-mail em 10/11" />
                    <div class="form-text">Fica no histórico da conta.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-dark">Encerrar conta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-cobranca-tenant" tabindex="-1" aria-labelledby="titulo-cobranca-tenant">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="form-cobranca-tenant" autocomplete="off">
                <div class="modal-header">
                    <h5 class="modal-title" id="titulo-cobranca-tenant">Cobrança da conta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div id="erro-cobranca-tenant" class="alert alert-danger d-none"></div>
                    <p class="mb-2">Conta: <strong id="nome-tenant-cobranca"></strong></p>
                    <p class="small text-muted mb-3" id="explicacao-cobranca-tenant"></p>
                    <div class="mb-3 d-none" id="grupo-dias-cobranca">
                        <label class="form-label" for="dias-cobranca">Dias a mais</label>
                        <input type="number" class="form-control" id="dias-cobranca" min="1" max="90" value="15" />
                        <div class="form-text">De 1 a 90 por vez; até 180 somando todas as prorrogações.</div>
                    </div>
                    <div class="mb-3 d-none" id="grupo-ate-cobranca">
                        <label class="form-label" for="ate-cobranca">Isenta até (inclusive)</label>
                        <input type="date" class="form-control" id="ate-cobranca" />
                        <div class="form-text">Em branco = sem prazo (ex.: sua própria conta, parceiros).</div>
                    </div>
                    <label class="form-label" for="motivo-cobranca">Motivo</label>
                    <input type="text" class="form-control" id="motivo-cobranca" maxlength="300" required placeholder="ex.: contador parceiro, testando com clientes" />
                    <div class="form-text">Fica registrado no histórico da conta.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btn-confirmar-cobranca">Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-excluir-tenant" tabindex="-1" aria-labelledby="titulo-excluir-tenant">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="form-excluir-tenant" autocomplete="off">
                <div class="modal-header">
                    <h5 class="modal-title" id="titulo-excluir-tenant"><i class="bi bi-trash"></i> Excluir conta definitivamente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div id="erro-excluir-tenant" class="alert alert-danger d-none"></div>
                    <p class="mb-2">Conta: <strong id="nome-tenant-excluir"></strong></p>
                    <div class="alert alert-warning small mb-3">
                        Será apagado <strong>tudo</strong>, sem volta: <span id="resumo-exclusao-tenant"></span>,
                        além de grupos, históricos, e-mails, certificados e documentos dos contratos.
                    </div>
                    <label class="form-label" for="codigo-exclusao">Código enviado para <strong id="email-codigo-exclusao"></strong></label>
                    <input type="text" class="form-control form-control-lg text-center" id="codigo-exclusao"
                           inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required placeholder="000000" style="letter-spacing:.4em" />
                    <div class="form-text" id="tempo-codigo-exclusao">&nbsp;</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger" id="btn-confirmar-exclusao"><i class="bi bi-trash"></i> Excluir conta</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* PL1: recursos da conta (o que vale e de onde vem) e exceções (plataforma.js, abrirRecursosConta) *@
<div class="modal fade" id="modal-recursos-conta" tabindex="-1" aria-labelledby="titulo-recursos-conta">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="titulo-recursos-conta">Recursos da conta</h5>
                    <div class="small text-muted" id="subtitulo-recursos-conta"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div id="erro-recursos-conta" class="alert alert-danger d-none"></div>
                <h6 class="text-muted text-uppercase small fw-bold">O que vale hoje</h6>
                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Recurso</th><th>Vale</th><th>De onde vem</th><th class="text-end"></th></tr></thead>
                        <tbody id="corpo-recursos-conta"></tbody>
                    </table>
                </div>

                <form id="form-excecao-recurso" class="border rounded p-3 bg-body-tertiary d-none" novalidate>
                    <h6 class="mb-2" id="titulo-excecao-recurso">Exceção</h6>
                    <div class="row g-2">
                        <div class="col-md-5">
                            <label class="form-label small mb-1">Valor nesta conta</label>
                            <div id="controle-excecao-recurso"></div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-1" for="excecao-valida-ate">Vale até (inclusive)</label>
                            <input type="date" class="form-control form-control-sm" id="excecao-valida-ate" />
                            <div class="form-text">Em branco = sem prazo.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-1" for="excecao-motivo">Motivo</label>
                            <input type="text" class="form-control form-control-sm" id="excecao-motivo" maxlength="300"
                                   placeholder="ex.: cortesia de lançamento, negociação com o escritório X" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-cancelar-excecao">Cancelar</button>
                        <button type="submit" class="btn btn-sm btn-primary">Salvar exceção</button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <span class="me-auto small text-muted">A exceção vence o plano enquanto valer. Toda mudança fica no histórico da conta.</span>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/paginas/recursos-plano.js" asp-append-version="true"></script>
    <script src="~/js/paginas/plataforma.js" asp-append-version="true"></script>
}
