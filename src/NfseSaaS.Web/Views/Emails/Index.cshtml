@{
    ViewData["Title"] = "E-mails";
}

<div class="card">
    <div class="card-body">
        @* Pesquisa daqui vai ao servidor (destinatário): a barra não ganha a pesquisa automática. *@
        <div class="barra-lista" id="barra-tabela-emails" data-sem-pesquisa="true">
            <label class="busca-lista">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" class="form-control" id="filtro-busca" placeholder="Buscar destinatário…" aria-label="Buscar destinatário" />
            </label>
            <select class="form-select form-select-sm" id="filtro-status" style="width: auto;">
                <option value="">Todos os status</option>
                <option value="Pendente">Pendente</option>
                <option value="Enviado">Enviado</option>
                <option value="Falhou">Falhou</option>
            </select>
            <select class="form-select form-select-sm" id="filtro-tipo" style="width: auto;">
                <option value="">Todos os tipos</option>
                <option value="Convite">Convite</option>
                <option value="ResetSenha">Reset de senha (Admin)</option>
                <option value="EsqueciSenha">Esqueci minha senha</option>
                <option value="AvisoTrocaSenha">Aviso de troca de senha</option>
                <option value="AvisoDuploFator">Aviso de verificação em duas etapas</option>
                <option value="NfseTomador">Nota ao cliente</option>
                <option value="CertificadoVencendo">Certificado vencendo</option>
                <option value="DocumentoVencendo">Documento vencendo</option>
                <option value="ConfirmacaoEmail">Confirmação de e-mail</option>
                <option value="ReajustesAniversario">Reajustes de contrato</option>
                <option value="AlertaOperador">Alerta do sistema</option>
                <option value="AvisoCobranca">Aviso de cobrança</option>
                <option value="ConviteIndicacao">Convite de indicação</option>
                <option value="NovosTermos">Aviso de novos termos</option>
                <option value="ExportacaoDados">Exportação dos dados</option>
                <option value="EncerramentoConta">Encerramento da conta</option>
                <option value="AvisoEncerramentoConta">Aviso de encerramento</option>
                <option value="ReajusteAssinatura">Reajuste da assinatura</option>
            </select>
        </div>
        <table id="tabela-emails" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Destinatário</th>
                    <th>Tipo</th>
                    <th>Assunto</th>
                    <th>Status</th>
                    <th>Tentativas</th>
                    <th>Criado em</th>
                    <th>Ações</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="modal-erro-email" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalhe do erro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <pre id="erro-email-detalhe" class="text-danger small" style="white-space: pre-wrap;"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/paginas/emails.js" asp-append-version="true"></script>
}
