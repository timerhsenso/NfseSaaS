@using NfseSaaS.Domain.Legal
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Termos de uso e privacidade";
}

<h5 class="card-title mb-2">Antes de continuar</h5>
<p class="text-muted small mb-3">
    Para usar o micoempresa, leia e aceite os documentos abaixo, vigentes desde
    @DocumentosLegais.VigentesDesde.ToString("dd/MM/yyyy").
</p>

<ul class="lista-documentos-legais">
    <li>
        <a href="/termos" target="_blank" rel="noopener">
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
            <span>Termos de uso <small>versão @DocumentosLegais.VersaoTermosDeUso</small></span>
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
        </a>
    </li>
    <li>
        <a href="/privacidade" target="_blank" rel="noopener">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            <span>Política de privacidade <small>versão @DocumentosLegais.VersaoPoliticaPrivacidade</small></span>
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
        </a>
    </li>
</ul>

<div id="erro-aceite" class="alert alert-danger d-none"></div>

<form id="form-aceite" data-return-url="@ViewData["ReturnUrl"]">
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="aceito" />
        <label class="form-check-label small" for="aceito">
            Li e aceito os Termos de uso e a Política de privacidade.
        </label>
    </div>
    <button type="submit" class="btn btn-primary w-100">Aceitar e continuar</button>
</form>

<div class="text-center mt-3">
    <a href="#" id="link-sair-aceite" class="small">Não aceito — sair</a>
</div>

@section Scripts {
    <script src="~/js/paginas/aceitar-termos.js" asp-append-version="true"></script>
}
