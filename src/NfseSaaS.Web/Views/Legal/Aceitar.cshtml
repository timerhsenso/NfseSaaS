@using NfseSaaS.Application.Common
@using NfseSaaS.Application.Legal
@using NfseSaaS.Domain.Legal
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Termos de uso e privacidade";
    var hoje = DataBrasilia.Hoje();
    var atual = DocumentosLegais.Atual(hoje);
    var jaVale = atual.Vigente(hoje);
    var data = atual.VigenteDesde.ToString("dd/MM/yyyy");
    var termosPendentes = ViewData["TermosPendentes"] as bool? ?? true;
    var pend = ViewData["Pendencias"] as PendenciasInstrumentos ?? PendenciasInstrumentos.Nenhuma;
    var dpaExigido = pend.DpaPendente && (termosPendentes || pend.DpaObrigatorio);
    var soOpcionais = !termosPendentes && !dpaExigido;
}

@* Tela de aceite (ExigeAceiteTermosFilter manda para cá). JUR1: além dos Termos e da Política,
   o administrador aceita o DPA (em nome da conta) e as autorizações do certificado A1 e da
   emissão automática, uma caixa por empresa, todas desmarcadas. Gravação: api/legal/aceitar. *@

<h5 class="card-title mb-2">
    @if (termosPendentes)
    {
        @(jaVale ? "Antes de continuar" : "Novos Termos de uso e Política de privacidade")
    }
    else
    {
        @:Autorizações da conta
    }
</h5>
<p class="text-muted small mb-3">
    @if (termosPendentes && jaVale)
    {
        @:Para usar o micoempresa, leia e aceite os documentos abaixo, vigentes desde @data.
    }
    else if (termosPendentes)
    {
        @:Os documentos abaixo passam a valer em @data. Leia o que mudou (no topo de cada um) e aceite quando quiser até lá; a partir dessa data, o aceite é necessário para continuar usando o micoempresa.
    }
    else
    {
        @:Como administrador, revise as autorizações abaixo. Cada caixa vale só para a empresa indicada.
    }
</p>

<div id="erro-aceite" class="alert alert-danger d-none" role="alert"></div>

<form id="form-aceite" data-return-url="@ViewData["ReturnUrl"]" data-termos="@(termosPendentes ? "1" : "0")" data-dpa-exigido="@(dpaExigido ? "1" : "0")" novalidate>
    @if (termosPendentes)
    {
        <ul class="lista-documentos-legais">
            <li>
                <a href="/termos" target="_blank" rel="noopener">
                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                    <span>Termos de uso <small>versão @atual.Versao</small></span>
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                </a>
            </li>
            <li>
                <a href="/privacidade" target="_blank" rel="noopener">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    <span>Política de privacidade <small>versão @atual.Versao</small></span>
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                </a>
            </li>
        </ul>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="aceito" />
            <label class="form-check-label small" for="aceito">
                Li e aceito os Termos de uso e a Política de privacidade.
            </label>
        </div>
    }

    @if (pend.DpaPendente)
    {
        <div class="aceite-instrumento" id="bloco-dpa">
            <div class="aceite-instrumento-titulo">
                <i class="bi bi-people" aria-hidden="true"></i>
                <a href="/dpa" target="_blank" rel="noopener">Acordo de Tratamento de Dados Pessoais (DPA)</a> <small class="text-muted">versão @pend.VersaoDpa</small>
            </div>
            <p class="small text-muted mb-2">Regula como tratamos os dados dos seus clientes e tomadores, em nome da sua conta. Aceito uma vez, pelo administrador.</p>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="aceito-dpa" />
                <label class="form-check-label small" for="aceito-dpa">
                    Li e aceito o Acordo de Tratamento de Dados em nome da conta.
                </label>
            </div>
        </div>
    }

    @if (pend.Certificados.Count > 0)
    {
        <div class="aceite-instrumento" id="bloco-certificados">
            <div class="aceite-instrumento-titulo">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <a href="/autorizacao-certificado" target="_blank" rel="noopener">Autorização do certificado digital A1</a> <small class="text-muted">versão @pend.VersaoAutorizacaoCertificado</small>
            </div>
            <p class="small text-muted mb-2">
                Autoriza guardar o certificado e usá-lo só nas operações fiscais que você aprovar. A partir de @data,
                a empresa sem esta autorização só emite depois de autorizar.
            </p>
            @foreach (var e in pend.Certificados)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="certificado" value="@e.EmpresaId" id="cert-@e.EmpresaId" />
                    <label class="form-check-label small" for="cert-@e.EmpresaId">
                        Tenho poderes e autorizo o uso do certificado A1 de <strong>@e.Nome</strong> (CNPJ @NfseSaaS.Application.UseCases.Importacao.RegrasImportacao.FormatarDocumento(e.Cnpj)), conforme a autorização.
                    </label>
                </div>
            }
        </div>
    }

    @if (pend.EmissaoAutomatica.Count > 0)
    {
        <div class="aceite-instrumento" id="bloco-automatica">
            <div class="aceite-instrumento-titulo">
                <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                <a href="/autorizacao-emissao-automatica" target="_blank" rel="noopener">Autorização de emissão automática</a> <small class="text-muted">versão @pend.VersaoAutorizacaoEmissaoAutomatica</small>
            </div>
            <p class="small text-muted mb-2">
                Estas empresas usam a Nota Mensal automática. Para ela continuar emitindo sozinha, dentro das regras da
                autorização, marque a empresa. Sem marcar, a partir de @data a Nota Mensal dela passa a só listar as notas para você revisar.
            </p>
            @foreach (var e in pend.EmissaoAutomatica)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="automatica" value="@e.EmpresaId" id="auto-@e.EmpresaId" />
                    <label class="form-check-label small" for="auto-@e.EmpresaId">
                        Autorizo a emissão automática das notas mensais de <strong>@e.Nome</strong> (CNPJ @NfseSaaS.Application.UseCases.Importacao.RegrasImportacao.FormatarDocumento(e.Cnpj)), só dentro das regras da autorização.
                    </label>
                </div>
            }
            <div class="mt-2 d-none" id="caixa-senha-automatica">
                <label class="form-label small mb-1" for="senha-automatica">Confirme a sua senha para autorizar</label>
                <input type="password" class="form-control form-control-sm" id="senha-automatica" autocomplete="current-password" />
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary w-100 mt-2" id="btn-aceitar">
        @(termosPendentes ? "Aceitar e continuar" : "Salvar autorizações")
    </button>
</form>

<div class="text-center mt-3">
    @if (soOpcionais)
    {
        <a href="@ViewData["ReturnUrl"]" class="small" id="link-depois-aceite">Agora não</a>
    }
    else
    {
        <a href="#" id="link-sair-aceite" class="small">Não aceito — sair</a>
    }
</div>

@section Scripts {
    <script src="~/js/paginas/aceitar-termos.js" asp-append-version="true"></script>
}
