@{
    ViewData["Title"] = "Grupos de permissão";
    var podeIncluir = User.PodeIncluir(NfseSaaS.Application.Authorization.TelaCatalogo.Grupos);
    var podeAlterar = User.PodeAlterar(NfseSaaS.Application.Authorization.TelaCatalogo.Grupos);
    var podeExcluir = User.PodeExcluir(NfseSaaS.Application.Authorization.TelaCatalogo.Grupos);
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Grupos de permissão</span>
        @if (podeIncluir)
        {
            <button type="button" class="btn btn-primary btn-sm" id="btn-novo-grupo">
                <i class="bi bi-plus-lg"></i> Novo grupo
            </button>
        }
    </div>
    <div class="card-body">
        <table id="tabela-grupos" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Descrição</th>
                    <th>Usuários</th>
                    <th>Origem</th>
                    <th>Ações</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="modal-grupo" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="form-grupo">
                <div class="modal-header">
                    <h5 class="modal-title" id="titulo-modal-grupo">Novo grupo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="erro-grupo" class="alert alert-danger d-none"></div>
                    <input type="hidden" id="grupoId" />
                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <input type="text" class="form-control" id="grupoNome" maxlength="100" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descrição</label>
                        <textarea class="form-control" id="grupoDescricao" maxlength="500" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-matriz" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Permissões de <span id="matriz-grupo-nome"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="matriz-aviso-admin" class="alert alert-info d-none">
                    O grupo Administrador sempre tem acesso total — não é possível editar esta matriz.
                </div>
                <table class="table table-sm table-bordered align-middle" id="tabela-matriz">
                    <thead>
                        <tr>
                            <th>Tela</th>
                            <th class="text-center">Incluir</th>
                            <th class="text-center">Alterar</th>
                            <th class="text-center">Excluir</th>
                            <th class="text-center">Consultar</th>
                        </tr>
                    </thead>
                    <tbody id="matriz-corpo"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" id="btn-salvar-matriz">Salvar permissões</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.__gruposPermissoes = {
            podeAlterar: @Html.Raw(podeAlterar.ToString().ToLowerInvariant()),
            podeExcluir: @Html.Raw(podeExcluir.ToString().ToLowerInvariant())
        };
    </script>
    <script src="~/js/paginas/grupos.js" asp-append-version="true"></script>
}
