@using NfseSaaS.Application.UseCases.Aparencia
@{
    ViewData["Title"] = "Configurações da conta";
}

@* O que vale para a CONTA inteira (todos os usuários), separado por seção.
   As cores do sistema continuam no painel Aparência (botão do topo). *@
<p class="text-muted mb-3" id="config-conta-intro">Vale para todos os usuários desta conta.</p>

<div class="card config-conta-secao mb-3" id="dados">
    <div class="card-header"><i class="bi bi-person-vcard" aria-hidden="true"></i> Dados da conta</div>
    <div class="card-body">
        <dl class="row small mb-3" id="dados-cadastro">
            <dt class="col-sm-4 text-muted fw-normal">Titular</dt>
            <dd class="col-sm-8" id="dado-nome">—</dd>
            <dt class="col-sm-4 text-muted fw-normal">CPF/CNPJ</dt>
            <dd class="col-sm-8" id="dado-documento">—</dd>
            <dt class="col-sm-4 text-muted fw-normal">E-mail do responsável</dt>
            <dd class="col-sm-8" id="dado-email">—</dd>
        </dl>
        <form id="form-contato-conta" novalidate>
            <label class="form-label" for="whatsapp-conta">WhatsApp do responsável</label>
            <input type="tel" class="form-control" id="whatsapp-conta" inputmode="numeric" placeholder="(71) 99999-8888" style="max-width: 260px" />
            <div class="form-text">Para o micoempresa falar com você (suporte e avisos da conta). Não aparece para os seus clientes.</div>
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="autoriza-whatsapp-conta" />
                <label class="form-check-label small" for="autoriza-whatsapp-conta">
                    Aceito receber contato e avisos do micoempresa por WhatsApp (notas, reajustes, segurança da conta).
                </label>
            </div>
            <div class="mt-3" id="acoes-contato-conta">
                <button type="submit" class="btn btn-primary btn-sm" id="btn-salvar-contato">
                    <i class="bi bi-check2" aria-hidden="true"></i> Salvar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card config-conta-secao" id="logomarca">
    <div class="card-header"><i class="bi bi-image" aria-hidden="true"></i> Logomarca</div>
    <div class="card-body">
        <p class="small text-muted mb-3" id="logo-ajuda">Aparece no topo do menu e no alto das impressões das listas.</p>
        <div class="logo-previa logo-previa-grande" id="logo-previa">
            <span class="text-muted small">Sem logomarca: usando a marca do micoempresa.</span>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3" id="logo-acoes">
            <label class="btn btn-primary btn-sm mb-0" for="arquivo-logo">
                <i class="bi bi-upload" aria-hidden="true"></i> Enviar logomarca
            </label>
            <input type="file" id="arquivo-logo" accept="image/png,image/jpeg,image/webp" class="visually-hidden" />
            <button type="button" class="btn btn-outline-danger btn-sm d-none" id="btn-remover-logo">
                <i class="bi bi-trash" aria-hidden="true"></i> Remover
            </button>
        </div>
        <small class="text-muted d-block mt-2" id="logo-formato">PNG, JPG ou WebP até @(RegrasLogoConta.TamanhoMaximoBytes / 1024) KB. Prefira formato horizontal e fundo transparente.</small>
    </div>
</div>

@section Scripts {
    <script src="~/js/paginas/configuracoes-conta.js" asp-append-version="true"></script>
}
