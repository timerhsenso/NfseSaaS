@{
    ViewData["Title"] = "Serviços";
    // Permissão do Grupo (IAEC), a mesma que a API confere. Antes era o papel
    // antigo do Identity ("Administrador"), que contas criadas pelo cadastro
    // e grupos personalizados não têm — a tela escondia os botões.
    var podeEditar = User.PodeAlterar(NfseSaaS.Application.Authorization.TelaCatalogo.Servicos);
}

@section AcoesPagina {
    <div id="botoes-exportacao-tabela-servicos"></div>
    @if (podeEditar)
    {
        <button type="button" class="btn btn-primary btn-sm" id="btn-novo-servico" data-requer-empresa>
            <i class="bi bi-plus-lg"></i> Novo serviço
        </button>
    }
}

<div class="card">
    <div class="card-body">
        <table id="tabela-servicos" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Código tributação nacional</th>
                    <th>Código NBS</th>
                    <th>Valor padrão</th>
                    <th>Situação</th>
                    @if (podeEditar)
                    {
                        <th>Ações</th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (podeEditar)
{
    <div class="modal fade" id="modal-servico" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="form-servico">
                    <div class="modal-header">
                        <h5 class="modal-title" id="titulo-modal-servico">Novo serviço</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="erro-servico" class="alert alert-danger d-none"></div>
                        <input type="hidden" id="servicoId" />

                        <div class="mb-3">
                            <label class="form-label">Descrição</label>
                            <input type="text" class="form-control" id="descricao" maxlength="500" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Código de tributação nacional (cTribNac)</label>
                            <select class="form-control" id="codigoTributacaoNacional" style="width: 100%" required></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Código NBS</label>
                            <select class="form-control" id="codigoNbs" style="width: 100%" required></select>
                        </div>
                        <fieldset class="border rounded p-3 mb-3" id="grupo-ibscbs">
                            <legend class="float-none w-auto px-2 fs-6 mb-0">IBS/CBS (Reforma Tributária)</legend>
                            <p class="form-text mt-0" id="ibscbs-ajuda">Escolha o código de tributação nacional acima para ver as opções da tabela oficial.</p>
                            <div class="mb-2">
                                <label class="form-label" for="cClassTrib">Classificação tributária (cClassTrib)</label>
                                <select class="form-select" id="cClassTrib"></select>
                            </div>
                            <div class="mb-0">
                                <label class="form-label" for="cIndOp">Indicador da operação (cIndOp)</label>
                                <select class="form-select" id="cIndOp"></select>
                                <div class="form-text">Define onde o IBS é devido. Na dúvida, use a sugestão e confirme com o seu contador.</div>
                            </div>
                        </fieldset>
                        <div class="mb-3">
                            <label class="form-label">Valor padrão</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="valorPadrao" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/paginas/servicos.js" asp-append-version="true"></script>
}
