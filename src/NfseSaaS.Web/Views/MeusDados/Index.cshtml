@{
    ViewData["Title"] = "Meus dados";
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><i class="bi bi-download" aria-hidden="true"></i> Exportar os dados da conta</div>
            <div class="card-body">
                <p>
                    Baixe uma cópia de tudo o que a sua conta tem no micoempresa, num arquivo ZIP:
                </p>
                <ul>
                    <li><strong>Notas fiscais:</strong> o XML oficial e o PDF de cada nota autorizada ou cancelada, separados por empresa e mês;</li>
                    <li><strong>Cadastros:</strong> empresas, clientes, serviços, contratos (com o histórico de valores), usuários e as notas em planilha (CSV, abre no Excel) e em JSON;</li>
                    <li><strong>Documentos</strong> anexados aos contratos.</li>
                </ul>
                <p class="small text-muted">
                    Certificados digitais e senhas não saem da plataforma, por segurança. O arquivo é montado em segundo plano
                    (pode levar alguns minutos se a conta tiver muitas notas) e avisamos por e-mail quando estiver pronto.
                    Ele fica disponível por <span id="dias-validade">7</span> dias.
                </p>

                <div class="alert alert-warning d-none" id="aviso-exportacao" role="status"></div>

                <button type="button" class="btn btn-primary" id="btn-exportar" disabled>
                    <i class="bi bi-file-earmark-zip" aria-hidden="true"></i> Exportar meus dados
                </button>
            </div>
        </div>

        <div class="card mt-3 border-danger-subtle d-none" id="card-encerrar">
            <div class="card-header text-danger"><i class="bi bi-door-closed" aria-hidden="true"></i> Encerrar a conta</div>
            <div class="card-body">
                <p class="mb-2">Ao encerrar a conta:</p>
                <ul class="mb-3">
                    <li>ninguém da conta entra mais, a partir da hora em que você confirmar;</li>
                    <li id="item-assinatura">a assinatura é cancelada e nenhuma fatura nova é gerada;</li>
                    <li><span id="dias-expurgo">90</span> dias depois, os dados são <strong>apagados</strong>. As notas fiscais emitidas ficam guardadas pelo prazo exigido por lei (5 anos), sem acesso pela plataforma.</li>
                </ul>
                <p class="small text-muted">
                    <strong>Antes, exporte os seus dados</strong> (botão acima) e guarde o arquivo: depois de encerrar, só pelo e-mail do suporte.
                    Quer só parar de pagar? Basta cancelar a assinatura na tela Assinatura: a conta continua aberta para consulta.
                </p>
                <button type="button" class="btn btn-outline-danger" id="btn-encerrar">
                    <i class="bi bi-door-closed" aria-hidden="true"></i> Encerrar a conta
                </button>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Exportações</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-atualizar" title="Atualizar">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span class="visually-hidden">Atualizar</span>
                </button>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0" id="lista-exportacoes">
                    <li class="text-muted">Carregando…</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-encerrar" tabindex="-1" aria-labelledby="titulo-modal-encerrar" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="form-encerrar" novalidate>
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="titulo-modal-encerrar">Encerrar a conta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" id="erro-encerrar" role="alert"></div>
                <div id="passo-pedir-codigo">
                    <p>Para confirmar, enviamos um código de 6 números para o seu e-mail.</p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="ciente-encerrar">
                        <label class="form-check-label" for="ciente-encerrar">
                            Entendi que o acesso fecha na hora e que os dados serão apagados depois do prazo.
                        </label>
                    </div>
                </div>
                <div id="passo-codigo" class="d-none">
                    <p>Digite o código enviado para <strong id="email-codigo-encerrar"></strong> (vale <span id="minutos-codigo-encerrar">10</span> minutos).</p>
                    <label class="form-label" for="codigo-encerrar">Código</label>
                    <input type="text" class="form-control form-control-lg text-center" id="codigo-encerrar" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="\d{6}">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>
                <button type="button" class="btn btn-outline-danger" id="btn-pedir-codigo-encerrar">Enviar o código</button>
                <button type="submit" class="btn btn-danger d-none" id="btn-confirmar-encerrar">Encerrar a conta</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/paginas/meus-dados.js" asp-append-version="true"></script>
}
