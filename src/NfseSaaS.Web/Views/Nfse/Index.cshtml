@{
    ViewData["Title"] = "Notas Fiscais";
    // Permissão do Grupo (IAEC), a mesma que a API confere: emitir = Incluir,
    // cancelar = Excluir na tela Nfse (ver GrupoProvisionamentoService). Antes
    // era o papel antigo do Identity, que contas novas não têm.
    var podeEmitir = User.PodeIncluir(NfseSaaS.Application.Authorization.TelaCatalogo.Nfse);
    var podeCancelar = User.PodeExcluir(NfseSaaS.Application.Authorization.TelaCatalogo.Nfse);
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Notas fiscais emitidas</span>
        <div class="d-flex align-items-center gap-2">
            <div id="botoes-exportacao-tabela-nfse"></div>
            @if (podeEmitir)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-sincronizar-sefin" data-requer-empresa>
                    <i class="bi bi-cloud-download"></i> Buscar notas da SEFIN
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btn-nota-mensal" data-requer-empresa>
                    <i class="bi bi-calendar-check"></i> Nota Mensal
                </button>
                <button type="button" class="btn btn-primary btn-sm" id="btn-emitir-nfse" data-requer-empresa>
                    <i class="bi bi-plus-lg"></i> Emitir nota
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <div class="row align-items-end mb-3 g-2">
            <div class="col-auto">
                <label class="form-label small mb-1">De</label>
                <input type="date" class="form-control form-control-sm" id="filtro-data-inicio" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Até</label>
                <input type="date" class="form-control form-control-sm" id="filtro-data-fim" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Status</label>
                <select class="form-select form-select-sm" id="filtro-status">
                    <option value="">Todos</option>
                    <option value="0">Rascunho</option>
                    <option value="1">Processando</option>
                    <option value="2">Autorizada</option>
                    <option value="3">Rejeitada</option>
                    <option value="4">Cancelada</option>
                    <option value="5">Substituída</option>
                </select>
            </div>
            <div class="col-auto" style="min-width: 220px;">
                <label class="form-label small mb-1">Cliente</label>
                <select class="form-select form-select-sm" id="filtro-cliente">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-limpar-filtros-nfse">Limpar filtros</button>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-baixar-selecionadas" disabled>
                    <i class="bi bi-file-earmark-zip"></i> Baixar selecionadas
                </button>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-xml-mes" title="XML de todas as notas do mês, para o contador">
                    <i class="bi bi-filetype-xml"></i> XML do mês
                </button>
            </div>
        </div>
        <table id="tabela-nfse" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th style="width:30px"><input type="checkbox" class="form-check-input" id="check-selecionar-todas-nfse"></th>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Valor</th>
                    <th>Valor líquido</th>
                    <th>Status</th>
                    <th>Emissão</th>
                    <th>Ações</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (podeEmitir)
{
    <!-- Modal de emissão -->
    <div class="modal fade" id="modal-emitir-nfse" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="form-emitir-nfse">
                    <div class="modal-header">
                        <h5 class="modal-title" id="titulo-modal-emitir-nfse">Emitir nota fiscal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="erro-emitir-nfse" class="alert alert-danger d-none"></div>
                        <div id="aviso-reenvio-nfse" class="alert alert-warning d-none"></div>

                        @* Etapa 2: resumo para conferir antes de mandar para a SEFIN (montado em nfse.js, mostrarResumoEmissao). *@
                        <div id="emitir-resumo" class="d-none"></div>

                        <div id="emitir-campos">
                            @* C7: só aparece ao substituir uma nota autorizada. *@
                            <div id="bloco-substituicao-nfse" class="border rounded p-2 mb-3 d-none">
                                <div class="row">
                                    <div class="col-md-5 mb-2">
                                        <label class="form-label" for="emitir-motivoSubstituicao">Motivo da substituição</label>
                                        <select class="form-select" id="emitir-motivoSubstituicao"></select>
                                    </div>
                                    <div class="col-md-7 mb-2">
                                        <label class="form-label" for="emitir-descricaoMotivoSubstituicao">Descrição do motivo <span class="text-muted small" id="dica-descricao-motivo">(15 a 255 caracteres)</span></label>
                                        <input type="text" class="form-control" id="emitir-descricaoMotivoSubstituicao" maxlength="255" placeholder="ex.: descrição do serviço corrigida a pedido do cliente" />
                                    </div>
                                </div>
                            </div>
                        <div class="mb-3">
                            <label class="form-label">Cliente</label>
                            <select class="form-control" id="emitir-clienteId" style="width: 100%" required></select>
                        </div>
                        @* Começa oculto: só aparece quando o Cliente escolhido tem Contrato ativo (carregarContratosDoCliente em nfse.js). *@
                        <div class="mb-3 d-none" id="campo-emitir-contrato">
                            <label class="form-label">Contrato (opcional)</label>
                            <select class="form-select" id="emitir-contratoId"></select>
                        </div>
                        <div id="aviso-reajuste-contrato" class="alert alert-warning d-none"></div>
                        <div id="aviso-contrato-multiplos-servicos" class="alert alert-info d-none"></div>
                        <div class="mb-3">
                            <label class="form-label">Serviço</label>
                            <select class="form-select" id="emitir-servicoId" required></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="emitir-descricaoServico">Descrição do serviço nesta nota</label>
                            <textarea class="form-control" id="emitir-descricaoServico" maxlength="2000" rows="4" required></textarea>
                            <div class="d-flex justify-content-between gap-2 form-text">
                                <span>É este texto que sai na nota (campo "Discriminação do serviço" do PDF e do XML).</span>
                                <span id="contador-descricao-emissao" class="text-nowrap">0/2000</span>
                            </div>
                            @* Aparece quando o texto digitado é diferente do sugerido pelo serviço/contrato escolhido. *@
                            <div id="aviso-descricao-manual" class="form-text d-none">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Você editou a descrição ou o valor — eles são mantidos ao trocar serviço ou contrato.
                                <a href="#" id="link-usar-descricao-sugerida">Usar os do cadastro</a>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Valor do serviço</label>
                                <input type="number" step="0.01" min="0.01" class="form-control" id="emitir-valorServico" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Competência</label>
                                <input type="date" class="form-control" id="emitir-dataCompetencia" required />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3 d-flex align-items-center">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="emitir-issRetido" />
                                    <label class="form-check-label" for="emitir-issRetido">ISS retido pelo tomador</label>
                                </div>
                            </div>
                            @* Local da prestação (C2): vazio = município da empresa; contrato pode ter outro padrão. *@
                            <div class="col-12 mb-3 order-last">
                                <label class="form-label" for="emitir-localPrestacao">Local da prestação</label>
                                <select class="form-select" id="emitir-localPrestacao"><option></option></select>
                                <div class="form-text">Em branco, vai o município da empresa. Para serviços cujo ISS é devido onde o serviço é feito (limpeza, vigilância, mão de obra…), o ISS passa a ser do município escolhido.</div>
                            </div>
                            @* Só aparece com ISS retido — é quando a alíquota vai pra DPS (pAliq). *@
                            <div class="col-md-6 mb-3 d-none" id="campo-emitir-aliquotaIss">
                                <label class="form-label" for="emitir-aliquotaIss">Alíquota de ISS (%)</label>
                                <input type="number" step="0.01" min="0.01" max="5" class="form-control" id="emitir-aliquotaIss" placeholder="Alíquota da Empresa" />
                                <div class="form-text">Em branco, usa a alíquota cadastrada na Empresa.</div>
                            </div>
                        </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="btn-cancelar-emissao">Cancelar</button>
                        <button type="button" class="btn btn-outline-secondary d-none" id="btn-voltar-emissao"><i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar e editar</button>
                        <button type="submit" class="btn btn-primary" id="btn-confirmar-emissao">Revisar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal de detalhe: status, eventos (NfseEvento) e snapshot fiscal -->
<div class="modal fade" id="modal-detalhe-nfse" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalhe da nota</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @* Montado em nfse.js (abrirDetalheNfse): blocos Nota, Cliente e serviço, Descrição na nota, Valores e tributação, Erro. *@
                <div id="detalhe-nfse-dados"></div>

                <h6 class="text-muted mt-3">Histórico de eventos</h6>
                <ul class="list-group mb-3" id="detalhe-nfse-eventos"></ul>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <h6 class="text-muted mb-0">Dados técnicos (cadastro no momento da emissão)</h6>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-toggle-snapshot"
                            data-bs-toggle="collapse" data-bs-target="#detalhe-nfse-snapshot-collapse"
                            aria-expanded="false" aria-controls="detalhe-nfse-snapshot-collapse">
                        <i class="bi bi-chevron-down"></i> Mostrar
                    </button>
                </div>
                <div class="collapse" id="detalhe-nfse-snapshot-collapse">
                    <p class="form-text mt-2 mb-1">
                        Cópia de Empresa, Cliente e Serviço como estavam no cadastro quando a nota foi emitida.
                        Em <code>servico.descricaoCadastro</code> está o nome do serviço no catálogo — o texto que saiu na nota é o da
                        "Descrição na nota", acima.
                    </p>
                    <pre id="detalhe-nfse-snapshot" class="bg-body-tertiary p-2 rounded small"></pre>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-outline-primary" id="link-baixar-danfse" target="_blank" rel="noopener">
                    <i class="bi bi-file-earmark-pdf"></i> Baixar PDF (DANFSe)
                </a>
                <a class="btn btn-outline-primary" id="link-baixar-xml" download>
                    <i class="bi bi-filetype-xml"></i> Baixar XML
                </a>
                @if (podeCancelar)
                {
                    <button type="button" class="btn btn-outline-danger" id="btn-cancelar-nfse">Cancelar nota</button>
                }
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@if (podeCancelar)
{
    <div class="modal fade" id="modal-motivo-cancelamento" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="form-cancelar-nfse">
                    <div class="modal-header">
                        <h5 class="modal-title">Cancelar nota fiscal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="erro-cancelar-nfse" class="alert alert-danger d-none"></div>
                        <div class="mb-3">
                            <label class="form-label">Motivo do cancelamento</label>
                            <select class="form-select" id="codigoMotivoCancelamento" required>
                                <option value="1">Erro na emissão</option>
                                <option value="2">Serviço não prestado</option>
                                <option value="9">Outros</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Motivo</label>
                            <textarea class="form-control" id="motivoCancelamento" minlength="15" maxlength="255" required></textarea>
                            <div class="form-text">Mínimo de 15 caracteres (exigência da SEFIN Nacional).</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>
                        <button type="submit" class="btn btn-danger">Confirmar cancelamento</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (podeEmitir)
{
    <div class="modal fade" id="modal-nota-mensal" tabindex="-1"
         data-pode-editar-contratos="@(User.PodeAlterar(NfseSaaS.Application.Authorization.TelaCatalogo.Contratos) ? "true" : "false")">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nota Mensal — emissão em lote</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="erro-nota-mensal" class="alert alert-danger d-none"></div>

                    <div class="row align-items-end mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Competência</label>
                            <input type="month" class="form-control" id="nota-mensal-competencia" />
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-outline-secondary" id="btn-buscar-candidatos-nota-mensal">
                                <i class="bi bi-search"></i> Buscar contratos elegíveis
                            </button>
                        </div>
                    </div>

                    <div id="nota-mensal-sem-candidatos" class="text-muted small d-none">Nenhum contrato Mensal/Ativo encontrado pra esta Empresa.</div>

                    @* Valor por serviço: variável vem com o último valor; fixo vem do contrato. *@
                    <div id="barra-nota-mensal" class="d-flex flex-wrap align-items-center gap-2 mb-2 d-none">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-nm-repetir-ultimos"
                                title="Nos serviços de valor variável das linhas marcadas, usa o valor da última nota">
                            <i class="bi bi-arrow-repeat"></i> Repetir últimos valores
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btn-nm-gravar-todos"
                                title="Nos serviços de valor fixo que você alterou, grava o novo valor no contrato (Histórico de valores)">
                            <i class="bi bi-save"></i> Gravar alterações nos contratos
                        </button>
                        <span class="ms-auto small text-muted" id="total-nota-mensal"></span>
                    </div>

                    <table class="table table-sm table-striped d-none" id="tabela-nota-mensal">
                        <thead>
                            <tr>
                                <th style="width:30px"></th>
                                <th>Cliente</th>
                                <th>Descrição / serviços</th>
                                <th style="width:300px">Valor</th>
                                <th style="width:220px">Status</th>
                            </tr>
                        </thead>
                        <tbody id="linhas-nota-mensal"></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-primary" id="btn-emitir-nota-mensal" disabled>
                        <i class="bi bi-send"></i> Emitir selecionados
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="modal-xml-mes" tabindex="-1" aria-labelledby="titulo-xml-mes" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <form class="modal-content" id="form-xml-mes" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="titulo-xml-mes">XML do mês</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" id="erro-xml-mes" role="alert"></div>
                <label class="form-label" for="xml-mes-competencia">Mês de competência</label>
                <input type="month" class="form-control" id="xml-mes-competencia" required>
                <div class="form-text">Um arquivo ZIP com o XML oficial de cada nota autorizada ou cancelada da empresa no mês — o que o contador importa.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btn-baixar-xml-mes"><i class="bi bi-download"></i> Baixar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/paginas/nfse.js" asp-append-version="true"></script>
}
