@{
    ViewData["Title"] = "Clientes";
    // Permissão do Grupo (IAEC), a mesma que a API confere. Antes era o papel
    // antigo do Identity ("Administrador"), que contas criadas pelo cadastro
    // e grupos personalizados não têm — a tela escondia os botões.
    var podeEditar = User.PodeAlterar(NfseSaaS.Application.Authorization.TelaCatalogo.Clientes);
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Clientes cadastrados</span>
        <div class="d-flex align-items-center gap-2">
            <div id="botoes-exportacao-tabela-clientes"></div>
            @if (podeEditar)
            {
                <button type="button" class="btn btn-primary btn-sm" id="btn-novo-cliente">
                    <i class="bi bi-plus-lg"></i> Novo cliente
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table id="tabela-clientes" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Apelido</th>
                    <th>Nome (razão social)</th>
                    <th>CPF/CNPJ</th>
                    <th>Município (IBGE)</th>
                    <th>Situação</th>
                    @if (podeEditar)
                    {
                        <th>Ações</th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (podeEditar)
{
    <div class="modal fade" id="modal-cliente" tabindex="-1" aria-labelledby="titulo-modal-cliente">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="form-cliente">
                    <div class="modal-header">
                        <div class="modal-cabecalho-entidade">
                            <div class="entidade-avatar entidade-avatar-redondo" id="avatar-modal-cliente" aria-hidden="true"><i class="bi bi-person"></i></div>
                            <div>
                                <h5 class="modal-title" id="titulo-modal-cliente">Novo cliente</h5>
                                <div class="modal-subtitulo" id="subtitulo-modal-cliente">O tomador do serviço — como sai na nota.</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <div id="erro-cliente" class="alert alert-danger d-none"></div>
                        <input type="hidden" id="clienteId" />

                        <section class="form-secao">
                            <div class="form-secao-titulo">
                                <h3>Identificação</h3>
                                <p>CNPJ ou CPF e o nome que vai na nota.</p>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="cpfCnpj">CPF ou CNPJ</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="cpfCnpj" maxlength="14" required inputmode="numeric" placeholder="Somente números" />
                                        <button type="button" class="btn btn-outline-primary" id="btn-consultar-cnpj-cliente" title="Buscar dados na Receita Federal (só CNPJ, 14 dígitos)">
                                            <i class="bi bi-search"></i> Receita
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="apelido">Apelido</label>
                                    <input type="text" class="form-control" id="apelido" maxlength="40" required
                                           title="Nome curto usado nas telas e no nome do PDF. Não aparece na nota fiscal." />
                                </div>
                                <div class="col-12 mb-3">
                                    <label class="form-label" for="nome">Nome / razão social</label>
                                    <input type="text" class="form-control" id="nome" maxlength="200" required />
                                    <div class="form-text">A nota sai com este nome; o apelido aparece só nas telas e no nome do PDF.</div>
                                </div>
                            </div>
                        </section>

                        <section class="form-secao">
                            <div class="form-secao-titulo">
                                <h3>Contato</h3>
                                <p>E-mail e envio da nota.</p>
                            </div>
                            <div class="row">
                                <div class="col-md-7 mb-3">
                                    <label class="form-label" for="email">E-mail</label>
                                    <input type="email" class="form-control" id="email" maxlength="200" />
                                </div>
                                <div class="col-md-5 mb-3">
                                    <label class="form-label" for="telefone">Telefone</label>
                                    <input type="text" class="form-control" id="telefone" maxlength="20" inputmode="tel" />
                                </div>
                                <div class="col-12 mb-3">
                                    <div class="form-check form-switch m-0">
                                        <input class="form-check-input" type="checkbox" role="switch" id="enviarNfsePorEmail" />
                                        <label class="form-check-label" for="enviarNfsePorEmail">Enviar a nota por e-mail</label>
                                        <i class="bi bi-info-circle text-muted ms-1" tabindex="0"
                                           title="Assim que a nota é autorizada, o PDF e o XML vão para o e-mail acima (e para as cópias). Ao ligar, o e-mail passa a ser obrigatório."></i>
                                    </div>
                                </div>
                                <div class="col-12 mb-3 d-none" id="bloco-copias-cliente">
                                    <label class="form-label" for="emailsCopia">Com cópia para <span class="text-muted fw-normal">(opcional, até 5)</span></label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="emailsCopia" maxlength="510"
                                               placeholder="financeiro@empresa.com, contador@escritorio.com" />
                                        <input type="radio" class="btn-check" name="tipoCopiaCliente" id="copiaCc" value="cc" checked />
                                        <label class="btn btn-outline-primary" for="copiaCc" title="Cópia: todos veem quem recebeu">Cc</label>
                                        <input type="radio" class="btn-check" name="tipoCopiaCliente" id="copiaCco" value="cco" />
                                        <label class="btn btn-outline-primary" for="copiaCco" title="Cópia oculta: cada um vê só o próprio endereço">Cco</label>
                                    </div>
                                    <div class="form-text">Separe por vírgula. <strong>Cc</strong>: todos veem quem recebeu. <strong>Cco</strong>: cópia oculta.</div>
                                </div>
                            </div>
                        </section>

                        <section class="form-secao">
                            <div class="form-secao-titulo">
                                <h3>Endereço</h3>
                                <p>Digite o CEP ou clique na lupa: rua, bairro, UF e município vêm sozinhos.</p>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label" for="cep">CEP</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="cep" maxlength="9" required inputmode="numeric" placeholder="00000-000" />
                                        <button type="button" class="btn btn-outline-primary" id="btn-buscar-cep-cliente" title="Buscar o endereço pelo CEP" aria-label="Buscar o endereço pelo CEP">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                    <div class="form-text" id="status-cep-cliente"></div>
                                </div>
                                <div class="col-md-8 mb-3">
                                    <label class="form-label" for="codigoMunicipio">Município (código IBGE)</label>
                                    <input type="text" class="form-control" id="codigoMunicipio" maxlength="7" required inputmode="numeric" />
                                    <div class="form-text" id="nome-municipio-cliente">Preenchido pelo CEP.</div>
                                </div>
                                <div class="col-md-9 mb-3">
                                    <label class="form-label" for="logradouro">Logradouro</label>
                                    <input type="text" class="form-control" id="logradouro" maxlength="200" required />
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label" for="numero">Número</label>
                                    <input type="text" class="form-control" id="numero" maxlength="20" required />
                                </div>
                                <div class="col-md-5 mb-3">
                                    <label class="form-label" for="complemento">Complemento</label>
                                    <input type="text" class="form-control" id="complemento" maxlength="100" placeholder="Sala, bloco, andar" />
                                </div>
                                <div class="col-md-5 mb-3">
                                    <label class="form-label" for="bairro">Bairro</label>
                                    <input type="text" class="form-control" id="bairro" maxlength="100" required />
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label class="form-label" for="uf">UF</label>
                                    <input type="text" class="form-control" id="uf" maxlength="2" required placeholder="BA" />
                                </div>
                            </div>
                        </section>

                        <section class="form-secao">
                            <div class="form-secao-titulo">
                                <h3>Fiscal</h3>
                                <p>Padrão das notas para este cliente.</p>
                            </div>
                            <div class="row">
                                <div class="col-12 mb-3">
                                    <div class="form-check form-switch m-0">
                                        <input class="form-check-input" type="checkbox" role="switch" id="retemIss" />
                                        <label class="form-check-label" for="retemIss">Retém o ISS na fonte</label>
                                        <i class="bi bi-info-circle text-muted ms-1" tabindex="0"
                                           title="Órgão público ou empresa que a prefeitura obriga a reter. As notas para este cliente já saem com ISS retido (dá para mudar na hora de emitir)."></i>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <div class="modal-footer">
                        <span class="modal-rodape-info">Campos com <span class="text-danger">*</span> são obrigatórios</span>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/paginas/clientes.js" asp-append-version="true"></script>
}
