@{
    ViewData["Title"] = "Clientes";
    var podeEditar = User.IsInRole("Administrador");
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Clientes cadastrados</span>
        <div class="d-flex align-items-center gap-2">
            <div id="botoes-exportacao-tabela-clientes"></div>
            @if (podeEditar)
            {
                <button type="button" class="btn btn-primary btn-sm" id="btn-novo-cliente">
                    <i class="bi bi-plus-lg"></i> Novo cliente
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table id="tabela-clientes" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>CPF/CNPJ</th>
                    <th>Município (IBGE)</th>
                    <th>Situação</th>
                    @if (podeEditar)
                    {
                        <th>Ações</th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (podeEditar)
{
    <div class="modal fade" id="modal-cliente" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="form-cliente">
                    <div class="modal-header">
                        <h5 class="modal-title" id="titulo-modal-cliente">Novo cliente</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="erro-cliente" class="alert alert-danger d-none"></div>
                        <input type="hidden" id="clienteId" />

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">CPF/CNPJ</label>
                                <input type="text" class="form-control" id="cpfCnpj" maxlength="14" required placeholder="Somente números" />
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Nome</label>
                                <input type="text" class="form-control" id="nome" maxlength="200" required />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">E-mail</label>
                                <input type="email" class="form-control" id="email" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Telefone</label>
                                <input type="text" class="form-control" id="telefone" maxlength="20" />
                            </div>
                        </div>

                        <h6 class="text-muted">Endereço</h6>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Município (código IBGE)</label>
                                <input type="text" class="form-control" id="codigoMunicipio" maxlength="7" required />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">CEP</label>
                                <input type="text" class="form-control" id="cep" maxlength="8" required placeholder="Somente números" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Logradouro</label>
                                <input type="text" class="form-control" id="logradouro" maxlength="200" required />
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label">Número</label>
                                <input type="text" class="form-control" id="numero" maxlength="20" required />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5 mb-3">
                                <label class="form-label">Complemento</label>
                                <input type="text" class="form-control" id="complemento" maxlength="100" />
                            </div>
                            <div class="col-md-5 mb-3">
                                <label class="form-label">Bairro</label>
                                <input type="text" class="form-control" id="bairro" maxlength="100" required />
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label">UF</label>
                                <input type="text" class="form-control" id="uf" maxlength="2" required placeholder="BA" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/paginas/clientes.js" asp-append-version="true"></script>
}
