@{
    ViewData["Title"] = "Usuários";
}

<div class="card mb-4">
    <div class="card-header">Convidar usuário</div>
    <div class="card-body">
        <div id="erro-convite" class="alert alert-danger d-none"></div>
        <div id="sucesso-convite" class="alert alert-success d-none"></div>

        <form id="form-convite" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">E-mail</label>
                <input type="email" class="form-control" id="email" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Grupo</label>
                <select class="form-select" id="grupoId" required></select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Convidar</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">Usuários</div>
    <div class="card-body">
        <table id="tabela-usuarios" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>E-mail</th>
                    <th>Grupo</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="modal-grupo-usuario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="form-grupo-usuario">
                <div class="modal-header">
                    <h5 class="modal-title">Alterar grupo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="erro-grupo-usuario" class="alert alert-danger d-none"></div>
                    <input type="hidden" id="grupo-usuarioId" />
                    <p class="mb-2">Usuário: <strong id="grupo-usuario-email"></strong></p>
                    <label class="form-label">Novo grupo</label>
                    <select class="form-select" id="grupo-usuario-novo" required></select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/paginas/usuarios.js" asp-append-version="true"></script>
}
