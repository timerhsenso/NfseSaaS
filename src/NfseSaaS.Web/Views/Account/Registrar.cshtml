@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Criar conta";
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h5 class="card-title mb-0">Criar conta</h5>
    <span class="small text-muted" id="cadastro-etapa-numero">Etapa 1 de 3</span>
</div>
<div class="progress mb-3" style="height:4px" role="progressbar" aria-label="Progresso do cadastro">
    <div class="progress-bar" id="cadastro-progresso" style="width:33%"></div>
</div>

<div id="erro-registrar" class="alert alert-danger d-none" role="alert"></div>

@* Etapa 1: quem é *@
<section id="etapa-perfil" data-etapa="1">
    <p class="text-muted small mb-3">Grátis para testar, sem cartão. Leva 1 minuto.</p>
    <p class="fw-semibold mb-2">Você é:</p>
    <div class="d-grid gap-2">
        <button type="button" class="btn btn-outline-primary text-start p-3 btn-perfil" data-perfil="1">
            <i class="bi bi-building me-2" aria-hidden="true"></i><strong>Minha empresa emite as notas</strong>
            <div class="small text-muted ms-4">Você emite as notas da sua própria empresa.</div>
        </button>
        <button type="button" class="btn btn-outline-primary text-start p-3 btn-perfil" data-perfil="2">
            <i class="bi bi-briefcase me-2" aria-hidden="true"></i><strong>Sou contador ou escritório</strong>
            <div class="small text-muted ms-4">Você emite pelos seus clientes. Pode ser com CPF ou CNPJ.</div>
        </button>
    </div>
</section>

@* Etapa 2: documento (CNPJ com busca na Receita) *@
<section id="etapa-documento" data-etapa="2" class="d-none">
    <div class="mb-3">
        <label class="form-label" for="documento" id="rotulo-documento">CNPJ da empresa</label>
        <div class="input-group">
            <input type="text" class="form-control form-control-lg" id="documento" inputmode="numeric" autocomplete="off" maxlength="18" placeholder="00.000.000/0000-00" />
            <span class="input-group-text d-none" id="buscando-documento"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span class="visually-hidden">Buscando</span></span>
        </div>
        <div class="form-text" id="ajuda-documento">Digite os números; buscamos os dados na Receita Federal.</div>
    </div>

    <div id="empresa-encontrada" class="alert alert-success d-none">
        <div class="small text-muted">Sua empresa:</div>
        <div class="fw-semibold" id="empresa-encontrada-nome"></div>
        <div class="small" id="empresa-encontrada-local"></div>
    </div>
    <div id="aviso-documento" class="alert alert-warning small d-none"></div>

    <div class="mb-3 d-none" id="grupo-nome">
        <label class="form-label" for="nome" id="rotulo-nome">Nome da empresa (razão social)</label>
        <input type="text" class="form-control" id="nome" maxlength="200" autocomplete="organization" />
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" data-voltar="1" title="Voltar"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-primary flex-grow-1" id="btn-continuar-documento" disabled>Continuar</button>
    </div>
</section>

@* Etapa 3: acesso *@
<section id="etapa-acesso" data-etapa="3" class="d-none">
    <p class="small text-muted mb-3">Conta de <strong id="resumo-conta"></strong></p>
    <form id="form-registrar" novalidate>
        <div class="mb-3">
            <label class="form-label" for="email">Seu e-mail</label>
            <input type="email" class="form-control" id="email" required autocomplete="email" />
            <div class="form-text">Por ele você entra e recebe as notas e os avisos. Vamos pedir para confirmar.</div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="whatsapp">WhatsApp <span class="text-muted fw-normal">(opcional)</span></label>
            <input type="tel" class="form-control" id="whatsapp" inputmode="numeric" autocomplete="tel-national" placeholder="(71) 99999-8888" />
            <div class="form-text">Para falarmos com você mais rápido.</div>
            <div class="form-check mt-2 d-none" id="grupo-autoriza-whatsapp">
                <input class="form-check-input" type="checkbox" id="autorizaWhatsApp" />
                <label class="form-check-label small" for="autorizaWhatsApp">Aceito receber contato e avisos do micoempresa por WhatsApp.</label>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="senha">Senha</label>
            <div class="input-group">
                <input type="password" class="form-control" id="senha" required minlength="8" autocomplete="new-password" />
                <button type="button" class="btn btn-outline-secondary btn-toggle-senha" tabindex="-1" title="Mostrar/ocultar senha">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <div class="form-text">Pelo menos 8 caracteres.</div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="confirmarSenha">Confirme a senha</label>
            <div class="input-group">
                <input type="password" class="form-control" id="confirmarSenha" required minlength="8" autocomplete="new-password" />
                <button type="button" class="btn btn-outline-secondary btn-toggle-senha" tabindex="-1" title="Mostrar/ocultar senha">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="aceitouTermos" />
            <label class="form-check-label small" for="aceitouTermos">
                @if (NfseSaaS.Domain.Legal.DocumentosLegais.Atual(NfseSaaS.Application.Common.DataBrasilia.Hoje()).VersaoDpa is not null)
                {
                    @:Li e aceito os <a href="/termos" target="_blank" rel="noopener">Termos de uso</a>,
                    @:a <a href="/privacidade" target="_blank" rel="noopener">Política de privacidade</a>
                    @:e, em nome da conta, o <a href="/dpa" target="_blank" rel="noopener">Acordo de Tratamento de Dados</a>.
                }
                else
                {
                    @:Li e aceito os <a href="/termos" target="_blank" rel="noopener">Termos de uso</a>
                    @:e a <a href="/privacidade" target="_blank" rel="noopener">Política de privacidade</a>.
                }
            </label>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" data-voltar="2" title="Voltar"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
            <button type="submit" class="btn btn-primary flex-grow-1" id="btn-criar-conta">Criar conta</button>
        </div>
    </form>
</section>

<div class="text-center mt-3">
    <a href="/Account/Login">Já tenho uma conta</a>
</div>

@section Scripts {
    <script src="~/js/paginas/registrar.js" asp-append-version="true"></script>
}
