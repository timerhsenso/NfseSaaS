@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Criar conta";
}

<h5 class="card-title mb-4">Criar conta</h5>
<p class="text-muted small">Cria sua empresa (Tenant) e o primeiro usuário, com papel Administrador.</p>

<div id="erro-registrar" class="alert alert-danger d-none"></div>

<form id="form-registrar">
    <div class="mb-3">
        <label class="form-label" for="razaoSocialTenant">Razão social</label>
        <input type="text" class="form-control" id="razaoSocialTenant" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="cnpjTenant">CNPJ</label>
        <input type="text" class="form-control" id="cnpjTenant" required maxlength="14" placeholder="Somente números" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="email">E-mail</label>
        <input type="email" class="form-control" id="email" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="senha">Senha</label>
        <div class="input-group">
            <input type="password" class="form-control" id="senha" required minlength="8" autocomplete="new-password" />
            <button type="button" class="btn btn-outline-secondary btn-toggle-senha" tabindex="-1" title="Mostrar/ocultar senha">
                <i class="bi bi-eye"></i>
            </button>
        </div>
    </div>
    <button type="submit" class="btn btn-primary w-100">Criar conta</button>
</form>

<div class="text-center mt-3">
    <a href="/Account/Login">Já tenho uma conta</a>
</div>

@section Scripts {
    <script src="~/js/paginas/registrar.js" asp-append-version="true"></script>
}
