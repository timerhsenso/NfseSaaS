@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar";
}

<h5 class="card-title mb-4">Entrar</h5>

<div id="erro-login" class="alert alert-danger d-none"></div>

<form id="form-login" data-return-url="@ViewData["ReturnUrl"]">
    <div class="mb-3">
        <label class="form-label" for="email">E-mail</label>
        <input type="email" class="form-control" id="email" required autofocus />
    </div>
    <div class="mb-3">
        <label class="form-label" for="senha">Senha</label>
        <div class="input-group">
            <input type="password" class="form-control" id="senha" required />
            <button type="button" class="btn btn-outline-secondary btn-toggle-senha" tabindex="-1" title="Mostrar/ocultar senha">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <div class="text-end mt-1">
            <a href="/Account/EsqueciSenha" class="small">Esqueci minha senha</a>
        </div>
    </div>
    <button type="submit" class="btn btn-primary w-100">Entrar</button>
</form>

@* Verificação em duas etapas (B3): aparece depois da senha certa, quando ligada. *@
<form id="form-codigo" class="d-none" novalidate>
    <p class="mb-3">Enviamos um código de 6 dígitos para <strong id="email-codigo"></strong>. Digite-o abaixo (você tem <span id="minutos-codigo">5</span> minutos).</p>
    <div class="mb-3">
        <label class="form-label" for="codigo">Código</label>
        <input type="text" class="form-control form-control-lg text-center" id="codigo" inputmode="numeric" autocomplete="one-time-code" maxlength="9" placeholder="000000" />
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="lembrar-navegador" />
        <label class="form-check-label" for="lembrar-navegador">Não pedir de novo neste navegador por <span id="dias-lembrar">14</span> dias</label>
    </div>
    <button type="submit" class="btn btn-primary w-100">Confirmar</button>
    <div class="d-flex justify-content-between mt-2 small">
        <a href="#" id="link-reenviar-codigo">Enviar outro código</a>
        <a href="/Account/Login" id="link-voltar-login">Voltar</a>
    </div>
</form>

<div class="text-center mt-3">
    <a href="/Account/Registrar">Criar uma conta nova</a>
</div>

@section Scripts {
    <script src="~/js/paginas/login.js" asp-append-version="true"></script>
}
