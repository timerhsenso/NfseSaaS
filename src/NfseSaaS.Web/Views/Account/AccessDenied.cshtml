@{
    ViewData["Title"] = "Acesso negado";
}

<div class="card">
    <div class="card-body text-center py-5">
        <i class="bi bi-shield-lock display-1 text-danger"></i>
        <h4 class="mt-3">Você não tem permissão pra acessar esta tela</h4>
        <p class="text-muted">
            Se você acha que deveria ter acesso, fale com um Administrador do seu Tenant —
            ele pode ajustar o seu grupo de permissão na tela de Usuários.
        </p>
        <p class="text-muted small">
            Se a sua permissão acabou de ser alterada, você precisa sair e entrar de novo pra ela valer.
        </p>
        <a href="/" class="btn btn-primary">Voltar ao início</a>
    </div>
</div>
