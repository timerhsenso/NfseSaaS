@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Esqueci minha senha";
}

<h5 class="card-title mb-4">Esqueci minha senha</h5>
<p class="text-muted small">Informe seu e-mail — se ele existir na nossa base, você recebe um link pra redefinir a senha.</p>

<div id="erro-esqueci-senha" class="alert alert-danger d-none"></div>
<div id="sucesso-esqueci-senha" class="alert alert-success d-none"></div>

<form id="form-esqueci-senha">
    <div class="mb-3">
        <label class="form-label" for="email">E-mail</label>
        <input type="email" class="form-control" id="email" required autofocus />
    </div>
    <button type="submit" class="btn btn-primary w-100">Enviar link de redefinição</button>
</form>

<div class="text-center mt-3">
    <a href="/Account/Login">Voltar ao login</a>
</div>

@section Scripts {
    <script src="~/js/paginas/esqueci-senha.js" asp-append-version="true"></script>
}
