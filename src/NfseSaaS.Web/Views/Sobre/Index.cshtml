@{
    ViewData["Title"] = "Sobre";
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="text-muted small">Versão em produção</div>
                <div class="h4 mb-0" id="sobre-versao">—</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Commit</div>
                <div class="h5 mb-0"><code id="sobre-commit">—</code></div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Deploy em</div>
                <div class="h5 mb-0" id="sobre-deploy-em">—</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h6 class="mb-3">Histórico de mudanças</h6>
        <pre id="sobre-changelog" class="changelog-viewer"></pre>
    </div>
</div>

@section Scripts {
    <script src="~/js/paginas/sobre.js" asp-append-version="true"></script>
}
