@inject NfseSaaS.Application.UseCases.Empresas.IObterEmpresaPorIdUseCase ObterEmpresaPorIdUseCase
@inject Microsoft.Extensions.Options.IOptions<NfseSaaS.Application.Common.SuporteOptions> SuporteOpcoes
@inject NfseSaaS.Application.UseCases.Aparencia.IAparenciaUseCase AparenciaUseCase
@inject NfseSaaS.Application.Abstractions.IAceiteTermosService AceiteTermos
@inject NfseSaaS.Application.Abstractions.ICurrentUser UsuarioAtual
@{
    var papelAdministrador = User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Usuarios)
        || User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Grupos)
        || User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Auditoria)
        || User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Assinatura);
    var caminhoAtual = Context.Request.Path.Value?.TrimEnd('/') ?? "";

    // Aparência (paleta da conta + preferências do usuário) já no <html>:
    // a página nasce com as cores e tamanhos certos, sem "piscar". Quem
    // nunca salvou fica sem data-modo/classe de menu: tema-inicial.js usa o
    // que o navegador tinha guardado e aparencia.js grava isso no banco.
    var aparencia = await AparenciaUseCase.AtualAsync(Context.RequestAborted);

    // Aviso prévio dos Termos/Política novos: até a data em que passam a valer,
    // quem ainda não aceitou a versão atual vê o convite para ler e aceitar.
    var avisoNovosTermos = !NfseSaaS.Domain.Legal.DocumentosLegais.VersaoAtualVigente(NfseSaaS.Application.Common.DataBrasilia.Hoje())
        && UsuarioAtual.UserId is { } usuarioIdTermos
        && !await AceiteTermos.AceitouVersaoAtualAsync(usuarioIdTermos, Context.RequestAborted);
    var preferencias = aparencia.Preferencias;
    string Ativo(string caminho) => caminhoAtual.Equals(caminho, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var nomeUsuario = User.Identity?.Name ?? "Usuário";
    var iniciais = string.Concat(nomeUsuario.Split(new[] { '@', '.', ' ' }, StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(p => char.ToUpperInvariant(p[0])));

    // Badge de ambiente: vem SEMPRE da Empresa selecionada (cookie
    // EmpresaAtualId, escrito por empresa-atual.js), nunca de config —
    // não existe mais "ambiente do sistema". Resolvido aqui, no
    // servidor, só pra o badge já nascer certo no primeiro render (sem
    // esperar o JS popular o <select> do topo); o <select> em si
    // continua sendo montado no cliente (empresa-atual.js), então o
    // nome/CNPJ das opções não precisa ser buscado de novo aqui.
    string? rotuloAmbienteEmpresa = null;
    // Produção é o estado normal (verde discreto); homologação avisa (âmbar):
    // nota de homologação não tem valor fiscal.
    string classeAmbienteEmpresa = "chip-ambiente-homologacao";

    if (Guid.TryParse(Context.Request.Cookies["EmpresaAtualId"], out var empresaAtualId))
    {
        try
        {
            var empresaAtual = await ObterEmpresaPorIdUseCase.ExecutarAsync(empresaAtualId, Context.RequestAborted);
            var emProducao = empresaAtual.TipoAmbiente == NfseSaaS.Domain.Enums.TipoAmbiente.Producao;
            rotuloAmbienteEmpresa = emProducao ? "Produção" : "Homologação";
            classeAmbienteEmpresa = emProducao ? "chip-ambiente-producao" : "chip-ambiente-homologacao";
        }
        catch (NfseSaaS.Application.Exceptions.RecursoNaoEncontradoException)
        {
            // Cookie aponta pra uma Empresa que não existe mais (Tenant
            // errado, excluída) — empresa-atual.js detecta isso sozinho
            // no próximo load (empresa some da lista) e corrige o
            // cookie. Aqui só deixamos o badge em branco por essa carga.
        }
    }
}
<!DOCTYPE html>
<html lang="pt-br" data-paleta="@aparencia.Paleta" data-fonte="@preferencias.Fonte" data-densidade="@preferencias.Densidade"
      data-modo="@(aparencia.Salvo ? preferencias.Modo : null)" data-aparencia-salva="@(aparencia.Salvo ? "1" : "0")"
      class="@(aparencia.Salvo && preferencias.MenuRecolhido ? "menu-recolhido" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · micoempresa</title>

    <script src="~/js/tema-inicial.js" asp-append-version="true"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.5/css/buttons.bootstrap5.min.css" />
    @* TR1: tour guiado (Driver.js, MIT). *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.6/dist/driver.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-usuario-atual="@nomeUsuario" data-suporte="@SuporteOpcoes.Value.TextoContato"
      data-logo-conta="@(aparencia.LogoVersao is { } versaoLogo ? $"/api/aparencia/logo?v={versaoLogo}" : null)">
    <div class="app">
        <aside class="sidebar" id="sidebar">
            @if (aparencia.LogoVersao is { } logoVersao)
            {
                @* B9: logo da conta (plano Escritório) sobre uma placa clara — logo escuro
                   some no menu escuro. "com micoempresa" fica pequeno embaixo. *@
                <a href="/" class="brand brand-conta" aria-label="Início">
                    <span class="brand-logo-placa"><img src="/api/aparencia/logo?v=@logoVersao" alt="Logo da conta" class="brand-logo" id="logo-conta-menu" /></span>
                    <span class="brand-por">com micoempresa</span>
                </a>
            }
            else
            {
                <a href="/" class="brand" aria-label="micoempresa — início">
                    <div class="brand-mark" aria-hidden="true">m</div>
                    <div>
                        <strong>micoempresa<small>.com.br</small></strong>
                        <span>Gestão simplificada</span>
                    </div>
                </a>
            }

            <nav class="sidebar-nav" aria-label="Início">
                <a href="/" class="@Ativo("")"><span class="nav-icon bi bi-grid-1x2"></span>Dashboard</a>
                <a href="/Indicacao" class="@Ativo("/Indicacao")"><span class="nav-icon bi bi-gift"></span>Indique e ganhe</a>
            </nav>

            @* Módulo de NFS-e — o primeiro módulo do micoempresa. *@
            <div class="nav-label">Notas fiscais (NFS-e)</div>
            <nav class="sidebar-nav" aria-label="Notas fiscais">
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Nfse))
                {
                    <a href="/Nfse" class="@Ativo("/Nfse")"><span class="nav-icon bi bi-receipt"></span>Notas fiscais</a>
                }
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Contratos))
                {
                    <a href="/Contratos" class="@Ativo("/Contratos")"><span class="nav-icon bi bi-file-earmark-text"></span>Contratos</a>
                }
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Clientes))
                {
                    <a href="/Clientes" class="@Ativo("/Clientes")"><span class="nav-icon bi bi-people"></span>Clientes</a>
                }
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Servicos))
                {
                    <a href="/Servicos" class="@Ativo("/Servicos")"><span class="nav-icon bi bi-list-ul"></span>Serviços</a>
                }
            </nav>

            <div class="nav-label">Cadastros e referência</div>
            <nav class="sidebar-nav" aria-label="Cadastros">
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Empresas))
                {
                    <a href="/Empresas" class="@Ativo("/Empresas")"><span class="nav-icon bi bi-building"></span>Empresas</a>
                    <a href="/Documentos" class="@Ativo("/Documentos")"><span class="nav-icon bi bi-folder-check"></span>Documentos da empresa</a>
                }
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Empresas) || User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Clientes))
                {
                    <a href="/ModelosEmail" class="@Ativo("/ModelosEmail")"><span class="nav-icon bi bi-envelope-paper"></span>Modelos de e-mail</a>
                }
                @* Referência pública (tabela global): qualquer usuário autenticado vê. *@
                <a href="/Indices" class="@Ativo("/Indices")"><span class="nav-icon bi bi-graph-up-arrow"></span>Índices econômicos</a>
            </nav>

            @if (papelAdministrador)
            {
                <div class="nav-label">Administração</div>
                <nav class="sidebar-nav" aria-label="Administração">
                    @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Usuarios))
                    {
                        <a href="/Usuarios" class="@Ativo("/Usuarios")"><span class="nav-icon bi bi-person-plus"></span>Usuários</a>
                    }
                    @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Grupos))
                    {
                        <a href="/Grupos" class="@Ativo("/Grupos")"><span class="nav-icon bi bi-diagram-3"></span>Grupos de permissão</a>
                    }
                    @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Auditoria))
                    {
                        <a href="/AuditLogs" class="@Ativo("/AuditLogs")"><span class="nav-icon bi bi-shield-check"></span>Auditoria</a>
                    }
                    @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Emails))
                    {
                        <a href="/Emails" class="@Ativo("/Emails")"><span class="nav-icon bi bi-envelope"></span>E-mails enviados</a>
                    }
                    @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Assinatura))
                    {
                        <a href="/Assinatura" class="@Ativo("/Assinatura")"><span class="nav-icon bi bi-credit-card"></span>Assinatura</a>
                    }
                </nav>
            }

            @* Só o dono do SaaS (Plataforma:UsuariosOperadoresIds) — enxerga todas as contas. *@
            @if (User.EhOperadorPlataforma())
            {
                <div class="nav-label">Plataforma</div>
                <nav class="sidebar-nav" aria-label="Plataforma">
                    <a href="/Plataforma" class="@Ativo("/Plataforma")"><span class="nav-icon bi bi-buildings"></span>Contas</a>
                    <a href="/Plataforma/Planos" class="@Ativo("/Plataforma/Planos")"><span class="nav-icon bi bi-tags"></span>Planos</a>
                    <a href="/Plataforma/Documentos" class="@Ativo("/Plataforma/Documentos")"><span class="nav-icon bi bi-folder2-open"></span>Documentos</a>
                    <a href="/Logs" class="@Ativo("/Logs")"><span class="nav-icon bi bi-terminal"></span>Logs</a>
                    <a href="/Sobre" class="@Ativo("/Sobre")"><span class="nav-icon bi bi-info-circle"></span>Sobre</a>
                </nav>
            }

            <div class="sidebar-footer">
                <div class="support">
                    <strong>Precisa de ajuda?</strong>
                    <p>
                        <a href="/ajuda/certificado-digital-a1" target="_blank" rel="noopener">Certificado digital A1</a><br />
                        <a href="/erros-nfse" target="_blank" rel="noopener">Erros da NFS-e explicados</a>
                    </p>
                    <p class="mb-0"><partial name="_ContatoSuporte" /></p>
                </div>
            </div>
        </aside>

        <div class="mobile-overlay" id="overlaySidebar"></div>

        <main class="main">
            <header class="topbar">
                <div class="top-left">
                    <button type="button" class="menu-btn" id="botaoMenu" aria-label="Recolher menu" aria-controls="sidebar" aria-expanded="true">
                        <i class="bi bi-layout-sidebar" aria-hidden="true"></i>
                    </button>
                    <div class="breadcrumb"><strong>@ViewData["Title"]</strong></div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <select id="seletor-empresa-topo" class="form-select" style="width:auto" aria-label="Empresa selecionada" title="Empresa selecionada — vale pra todas as telas"></select>

                    @if (rotuloAmbienteEmpresa is not null)
                    {
                        <span class="chip-ambiente @classeAmbienteEmpresa" id="badge-ambiente-empresa"
                              title="@(rotuloAmbienteEmpresa == "Homologação" ? "Ambiente de testes da SEFIN: as notas não têm valor fiscal" : "Notas com valor fiscal")">@rotuloAmbienteEmpresa</span>
                    }

                    <button class="btn-tema" id="botaoTema" aria-label="Alternar tema claro/escuro" title="Alternar tema">
                        <i class="bi bi-moon-stars" id="iconeTema"></i>
                    </button>

                    <button class="btn-tema" id="botaoAparencia" type="button" data-bs-toggle="offcanvas" data-bs-target="#painelAparencia"
                            aria-controls="painelAparencia" aria-label="Aparência do sistema" title="Aparência">
                        <i class="bi bi-sliders2" aria-hidden="true"></i>
                    </button>

                    <div class="dropdown">
                        <div class="user-menu" data-bs-toggle="dropdown" role="button">
                            <div class="avatar">@iniciais</div>
                            <div class="user-meta">
                                <strong>@nomeUsuario</strong>
                                <span>@(papelAdministrador ? "Administrador" : "Usuário")</span>
                            </div>
                            <i class="bi bi-chevron-down text-muted small"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#modalAlterarSenha">Alterar senha</a></li>
                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#modalDuploFator">Verificação em duas etapas</a></li>
                            <li><a class="dropdown-item" href="/MeusDados">Meus dados</a></li>
                            @* TR1: tour guiado (tour.js esconde o primeiro onde a tela não tem tour). *@
                            <li><a class="dropdown-item" href="#" id="link-tour-tela"><i class="bi bi-signpost-2 me-1" aria-hidden="true"></i>Ver o tour desta tela</a></li>
                            <li><a class="dropdown-item" href="#" id="link-rever-tours">Rever todos os tours</a></li>
                            @if (aparencia.PodeAlterarPaleta)
                            {
                                @* Configurações que valem para a conta inteira (hoje: logomarca). Só o administrador. *@
                                <li><a class="dropdown-item" href="/ConfiguracoesConta">Configurações da conta</a></li>
                            }
                            <li><a class="dropdown-item" href="/termos" target="_blank" rel="noopener">Termos de uso</a></li>
                            <li><a class="dropdown-item" href="/privacidade" target="_blank" rel="noopener">Política de privacidade</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#" id="link-sair">Sair</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <section class="content">
                <div class="page-head">
                    <h1>@ViewData["Title"]</h1>
                    @if (IsSectionDefined("AcoesPagina"))
                    {
                        @* Ações da tela: Exportar ▾, ⋯ e a ação principal (padrão das listas, exportacao.js). *@
                        <div class="acoes-pagina">@await RenderSectionAsync("AcoesPagina")</div>
                    }
                </div>
                @if (avisoNovosTermos)
                {
                    <div class="alert alert-info d-flex align-items-start gap-2" role="status" id="aviso-novos-termos">
                        <i class="bi bi-file-earmark-text mt-1" aria-hidden="true"></i>
                        <div>
                            <strong>Termos de uso e Política de privacidade novos a partir de @NfseSaaS.Domain.Legal.DocumentosLegais.VigentesDesde.ToString("dd/MM/yyyy").</strong>
                            @NfseSaaS.Domain.Legal.DocumentosLegais.ResumoMudancas
                            <a href="/Legal/Aceitar?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Ler e aceitar agora</a>
                        </div>
                    </div>
                }
                @RenderBody()
            </section>
        </main>
    </div>

    <div class="toast-container-nfse" id="toastContainerNfse"></div>

    <div class="modal fade" id="modalConfirmacao" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalConfirmacaoTitulo">Confirmar ação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body" id="modalConfirmacaoMensagem"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="modalConfirmacaoBotaoConfirmar">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAlterarSenha" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="form-alterar-senha-modal">
                    <div class="modal-header">
                        <h5 class="modal-title">Alterar senha</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <div id="erro-senha-modal" class="alert alert-danger d-none"></div>
                        <div id="sucesso-senha-modal" class="alert alert-success d-none"></div>
                        <div class="mb-3">
                            <label class="form-label">Senha atual</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="senhaAtualModal" required autocomplete="current-password" />
                                <button type="button" class="btn btn-outline-secondary btn-toggle-senha" tabindex="-1" title="Mostrar/ocultar senha">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nova senha</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="novaSenhaModal" required minlength="8" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary btn-toggle-senha" tabindex="-1" title="Mostrar/ocultar senha">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirmar nova senha</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="confirmarNovaSenhaModal" required minlength="8" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary btn-toggle-senha" tabindex="-1" title="Mostrar/ocultar senha">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* Verificação em duas etapas (B3) — lógica em site.js. *@
    <div class="modal fade" id="modalDuploFator" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Verificação em duas etapas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div id="erro-duplo-fator" class="alert alert-danger d-none"></div>
                    <div id="sucesso-duplo-fator" class="alert alert-success d-none"></div>
                    <p class="text-muted small">Depois da senha, o login pede um código enviado para o seu e-mail (<strong id="email-duplo-fator"></strong>). Mesmo que alguém descubra a sua senha, não entra sem acesso ao seu e-mail.</p>

                    <div id="duplo-fator-desligado" class="d-none">
                        <p><span class="badge text-bg-secondary">Desligada</span></p>
                        <button type="button" class="btn btn-primary" id="btn-duplo-fator-enviar">Ligar: enviar código para o meu e-mail</button>
                        <form id="form-duplo-fator-ativar" class="d-none mt-3" novalidate>
                            <label class="form-label" for="codigo-duplo-fator">Código recebido</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="codigo-duplo-fator" inputmode="numeric" autocomplete="one-time-code" maxlength="9" placeholder="000000" />
                                <button type="submit" class="btn btn-primary">Ligar</button>
                            </div>
                        </form>
                    </div>

                    <div id="duplo-fator-ligado" class="d-none">
                        <p><span class="badge text-bg-success">Ligada</span></p>
                        <form id="form-duplo-fator-desligar" novalidate>
                            <label class="form-label" for="senha-duplo-fator">Para desligar, confirme a sua senha</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="senha-duplo-fator" autocomplete="current-password" />
                                <button type="submit" class="btn btn-outline-danger">Desligar</button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@2/js/dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.html5.min.js"></script>
