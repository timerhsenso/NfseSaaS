@inject NfseSaaS.Application.UseCases.Empresas.IObterEmpresaPorIdUseCase ObterEmpresaPorIdUseCase
@{
    var papelAdministrador = User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Usuarios)
        || User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Grupos)
        || User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Auditoria);
    var caminhoAtual = Context.Request.Path.Value?.TrimEnd('/') ?? "";
    string Ativo(string caminho) => caminhoAtual.Equals(caminho, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var nomeUsuario = User.Identity?.Name ?? "Usuário";
    var iniciais = string.Concat(nomeUsuario.Split(new[] { '@', '.', ' ' }, StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(p => char.ToUpperInvariant(p[0])));

    // Badge de ambiente: vem SEMPRE da Empresa selecionada (cookie
    // EmpresaAtualId, escrito por empresa-atual.js), nunca de config —
    // não existe mais "ambiente do sistema". Resolvido aqui, no
    // servidor, só pra o badge já nascer certo no primeiro render (sem
    // esperar o JS popular o <select> do topo); o <select> em si
    // continua sendo montado no cliente (empresa-atual.js), então o
    // nome/CNPJ das opções não precisa ser buscado de novo aqui.
    string? rotuloAmbienteEmpresa = null;
    string corAmbienteEmpresa = "secondary";

    if (Guid.TryParse(Context.Request.Cookies["EmpresaAtualId"], out var empresaAtualId))
    {
        try
        {
            var empresaAtual = await ObterEmpresaPorIdUseCase.ExecutarAsync(empresaAtualId, Context.RequestAborted);
            var emProducao = empresaAtual.TipoAmbiente == NfseSaaS.Domain.Enums.TipoAmbiente.Producao;
            rotuloAmbienteEmpresa = emProducao ? "Produção" : "Homologação";
            corAmbienteEmpresa = emProducao ? "danger" : "warning";
        }
        catch (NfseSaaS.Application.Exceptions.RecursoNaoEncontradoException)
        {
            // Cookie aponta pra uma Empresa que não existe mais (Tenant
            // errado, excluída) — empresa-atual.js detecta isso sozinho
            // no próximo load (empresa some da lista) e corrige o
            // cookie. Aqui só deixamos o badge em branco por essa carga.
        }
    }
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NfseSaaS</title>

    <script>
        // Aplica o tema salvo ANTES do resto da página renderizar — sem
        // isso, a tela pisca clara por uma fração de segundo antes de
        // escurecer (o CSS só carrega/aplica depois). localStorage, não
        // banco — a preferência é só deste navegador, como pedido.
        (function () {
            var tema = localStorage.getItem('nfsesaas-tema') || 'light';
            document.documentElement.setAttribute('data-theme', tema);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.5/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <div class="brand-mark">N</div>
                <div>
                    <strong>NfseSaaS</strong>
                    <span>Gestão de notas fiscais</span>
                </div>
            </div>

            <div class="nav-label">Principal</div>
            <nav class="sidebar-nav">
                <a href="/" class="@Ativo("")"><span class="nav-icon bi bi-speedometer2"></span>Dashboard</a>
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Empresas))
                {
                    <a href="/Empresas" class="@Ativo("/Empresas")"><span class="nav-icon bi bi-building"></span>Empresas</a>
                }
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Clientes))
                {
                    <a href="/Clientes" class="@Ativo("/Clientes")"><span class="nav-icon bi bi-people"></span>Clientes</a>
                }
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Contratos))
                {
                    <a href="/Contratos" class="@Ativo("/Contratos")"><span class="nav-icon bi bi-file-earmark-ruled"></span>Contratos</a>
                }
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Servicos))
                {
                    <a href="/Servicos" class="@Ativo("/Servicos")"><span class="nav-icon bi bi-list-check"></span>Serviços</a>
                }
                @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Nfse))
                {
                    <a href="/Nfse" class="@Ativo("/Nfse")"><span class="nav-icon bi bi-file-earmark-text"></span>Notas fiscais</a>
                }
            </nav>

            @if (papelAdministrador)
            {
                <div class="nav-label">Administração</div>
                <nav class="sidebar-nav">
                    @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Auditoria))
                    {
                        <a href="/AuditLogs" class="@Ativo("/AuditLogs")"><span class="nav-icon bi bi-shield-check"></span>Auditoria</a>
                    }
                    @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Usuarios))
                    {
                        <a href="/Usuarios" class="@Ativo("/Usuarios")"><span class="nav-icon bi bi-person-plus"></span>Usuários</a>
                    }
                    @if (User.TemAcesso(NfseSaaS.Application.Authorization.TelaCatalogo.Grupos))
                    {
                        <a href="/Grupos" class="@Ativo("/Grupos")"><span class="nav-icon bi bi-diagram-3"></span>Grupos de permissão</a>
                    }
                </nav>
            }

            <div class="sidebar-footer">
                <div class="support">
                    <strong>Precisa de ajuda?</strong>
                    <p>Fale com o suporte ou consulte a documentação.</p>
                </div>
            </div>
        </aside>

        <div class="mobile-overlay" id="overlaySidebar"></div>

        <main class="main">
            <header class="topbar">
                <div class="top-left">
                    <button class="menu-btn" id="botaoMenu" aria-label="Abrir menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="breadcrumb"><strong>@ViewData["Title"]</strong></div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <select id="seletor-empresa-topo" class="form-select form-select-sm" style="width:auto" title="Empresa selecionada — vale pra todas as telas"></select>

                    @if (rotuloAmbienteEmpresa is not null)
                    {
                        <span class="badge text-bg-@corAmbienteEmpresa" id="badge-ambiente-empresa" title="Ambiente da Empresa selecionada no topo">
                            <i class="bi bi-hdd-network"></i> @rotuloAmbienteEmpresa
                        </span>
                    }

                    <button class="btn-tema" id="botaoTema" aria-label="Alternar tema claro/escuro" title="Alternar tema">
                        <i class="bi bi-moon-stars" id="iconeTema"></i>
                    </button>

                    <div class="dropdown">
                        <div class="user-menu" data-bs-toggle="dropdown" role="button">
                            <div class="avatar">@iniciais</div>
                            <div class="user-meta">
                                <strong>@nomeUsuario</strong>
                                <span>@(papelAdministrador ? "Administrador" : "Usuário")</span>
                            </div>
                            <i class="bi bi-chevron-down text-muted small"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#modalAlterarSenha">Alterar senha</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#" id="link-sair">Sair</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <section class="content">
                <div class="page-head">
                    <h1>@ViewData["Title"]</h1>
                </div>
                @RenderBody()
            </section>
        </main>
    </div>

    <div class="toast-nfse" id="toastNfse"></div>

    <div class="modal fade" id="modalConfirmacao" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalConfirmacaoTitulo">Confirmar ação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body" id="modalConfirmacaoMensagem"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="modalConfirmacaoBotaoConfirmar">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAlterarSenha" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="form-alterar-senha-modal">
                    <div class="modal-header">
                        <h5 class="modal-title">Alterar senha</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <div id="erro-senha-modal" class="alert alert-danger d-none"></div>
                        <div id="sucesso-senha-modal" class="alert alert-success d-none"></div>
                        <div class="mb-3">
                            <label class="form-label">Senha atual</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="senhaAtualModal" required autocomplete="current-password" />
                                <button type="button" class="btn btn-outline-secondary btn-toggle-senha" tabindex="-1" title="Mostrar/ocultar senha">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nova senha</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="novaSenhaModal" required minlength="8" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary btn-toggle-senha" tabindex="-1" title="Mostrar/ocultar senha">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirmar nova senha</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="confirmarNovaSenhaModal" required minlength="8" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary btn-toggle-senha" tabindex="-1" title="Mostrar/ocultar senha">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@2/js/dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/empresa-atual.js" asp-append-version="true"></script>
    <script src="~/js/exportacao.js" asp-append-version="true"></script>

    <script>
        window.usuarioAtual = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nomeUsuario));

        // Sidebar em telas pequenas — substitui o toggle que vinha do
        // AdminLTE (removido junto com o resto da lib).
        (function () {
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('overlaySidebar');
            var botao = document.getElementById('botaoMenu');

            function fechar() {
                sidebar.classList.remove('open');
                overlay.classList.remove('show');
            }

            botao?.addEventListener('click', function () {
                sidebar.classList.toggle('open');
                overlay.classList.toggle('show');
            });
            overlay?.addEventListener('click', fechar);
        })();

        // Logout: chama a mesma API usada pelo Swagger/clients externos —
        // a tela MVC nunca duplica a lógica de autenticação, só consome
        // o endpoint /api/auth/* via fetch (mesmo padrão de todas as
        // outras telas, que consomem /api/empresas, /api/clientes etc.).
        document.getElementById('link-sair')?.addEventListener('click', async function (e) {
            e.preventDefault();
            await fetch('/api/auth/logout', { method: 'POST' });
            window.location.href = '/Account/Login';
        });

        // Tema claro/escuro — preferência só deste navegador (localStorage,
        // sem banco). O <head> já aplicou o tema salvo antes de renderizar
        // (evita o "flash" de tela clara); aqui só cuida do clique.
        (function () {
            var icone = document.getElementById('iconeTema');

            function atualizarIcone(tema) {
                icone.className = tema === 'dark' ? 'bi bi-sun' : 'bi bi-moon-stars';
            }

            atualizarIcone(document.documentElement.getAttribute('data-theme'));

            document.getElementById('botaoTema')?.addEventListener('click', function () {
                var temaAtual = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
                var novoTema = temaAtual === 'dark' ? 'light' : 'dark';

                document.documentElement.setAttribute('data-theme', novoTema);
                localStorage.setItem('nfsesaas-tema', novoTema);
                atualizarIcone(novoTema);
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
