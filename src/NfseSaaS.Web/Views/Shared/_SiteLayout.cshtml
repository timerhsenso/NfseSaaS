@using NfseSaaS.Domain.Legal
@*
    Layout das páginas públicas de divulgação: página inicial ("/" sem
    login) e explicação das rejeições da SEFIN (/erros-nfse). Sem menu do
    sistema e sem script de terceiros.

    ViewData usado: Title (sem o " · micoempresa"), Descricao (meta
    description, até ~160 caracteres), Canonical (caminho, ex.: "/erros-nfse").
*@
@{
    var titulo = ViewData["Title"] as string ?? "micoempresa";
    var descricao = ViewData["Descricao"] as string
        ?? "Emissor de NFS-e Nacional para ME e EPP do Simples: nota mensal automática, reajuste por índice e nota enviada por e-mail ao seu cliente.";
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{ViewData["Canonical"] as string ?? Context.Request.Path.Value}";
    var caminho = Context.Request.Path;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@titulo · micoempresa</title>
    <meta name="description" content="@descricao" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="micoempresa" />
    <meta property="og:title" content="@titulo" />
    <meta property="og:description" content="@descricao" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="site-page">
    <header class="site-topo">
        <div class="site-container site-topo-inner">
            <a href="/" class="legal-marca site-marca">
                <span class="legal-marca-mark" aria-hidden="true">m</span>
                <strong>micoempresa</strong>
            </a>
            <nav class="site-nav" aria-label="Site">
                <a href="/#recursos" class="site-nav-opcional">Recursos</a>
                <a href="/precos" class="site-nav-opcional @(caminho.StartsWithSegments("/precos") ? "ativo" : null)">Preços</a>
                <a href="/erros-nfse" class="site-nav-opcional @(caminho.StartsWithSegments("/erros-nfse") ? "ativo" : null)">Erros da NFS-e</a>
                <a href="/Account/Login">Entrar</a>
                <a href="@NfseSaaS.Web.Site.LinkCadastroExtensions.LinkCadastro(Context)" class="btn btn-primary btn-sm">Criar conta grátis</a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-rodape">
        <div class="site-container site-rodape-inner">
            <div>
                <a href="/" class="legal-marca site-marca site-marca-rodape">
                    <span class="legal-marca-mark" aria-hidden="true">m</span>
                    <strong>micoempresa</strong>
                </a>
                <p>Nota fiscal de serviço sem complicação para micro e pequenas empresas.</p>
                <p><partial name="_ContatoSuporte" model="@("bloco")" /></p>
            </div>
            <nav aria-label="Links do rodapé">
                <a href="/precos">Preços</a>
                <a href="/erros-nfse">Erros da NFS-e explicados</a>
                <a href="/ajuda/certificado-digital-a1">Certificado digital A1</a>
                <a href="@NfseSaaS.Web.Site.LinkCadastroExtensions.LinkCadastro(Context)">Criar conta</a>
                <a href="/Account/Login">Entrar</a>
                <a href="/termos">Termos de uso</a>
                <a href="/privacidade">Política de privacidade</a>
            </nav>
        </div>
        <div class="site-container site-rodape-final">
            <span>@DocumentosLegais.Site</span>
            <span>O micoempresa não é um serviço do governo. A emissão é feita no Emissor Nacional da NFS-e, com o certificado da sua empresa.</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
