@model bool
@using NfseSaaS.Application.UseCases.Aparencia
@*
    Painel lateral (offcanvas) "Aparência", aberto pelo botão do topo.
    Model = o usuário é administrador da conta (vê o atalho para
    Configurações da conta, onde ficam as cores e o logo da conta).
    Aqui ficam só as preferências DESTE usuário.
    Cada clique já mostra o resultado na tela (pré-visualização);
    "Salvar" grava, fechar sem salvar volta ao que estava (aparencia.js).
*@
<div class="offcanvas offcanvas-end painel-aparencia" tabindex="-1" id="painelAparencia" aria-labelledby="tituloAparencia">
    <div class="offcanvas-header">
        <div>
            <h5 class="offcanvas-title" id="tituloAparencia"><i class="bi bi-sliders2" aria-hidden="true"></i> Aparência</h5>
            <small class="text-muted">As mudanças aparecem na hora; salve para manter.</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
    </div>
    <div class="offcanvas-body">
        @if (Model)
        {
            @* Cores e logo são da CONTA (valem para todos): ficam em Configurações da conta. *@
            <a href="/ConfiguracoesConta" class="aparencia-link-conta">
                <i class="bi bi-palette" aria-hidden="true"></i>
                <span><strong>Cores e logo da conta</strong><small>Em Configurações da conta (vale para todos os usuários)</small></span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        }

        <section class="aparencia-secao">
            <h6>Minhas preferências</h6>
            <p class="aparencia-ajuda">Só para você, em qualquer computador.</p>

            <label class="form-label" id="rotulo-modo">Modo</label>
            <div class="btn-group w-100 aparencia-opcoes" role="radiogroup" aria-labelledby="rotulo-modo" data-campo="modo">
                @foreach (var o in AparenciaCatalogo.Modos)
                {
                    <button type="button" class="btn btn-outline-secondary" role="radio" data-valor="@o.Codigo" aria-checked="false">@o.Nome</button>
                }
            </div>

            <label class="form-label mt-3" id="rotulo-fonte">Tamanho do texto</label>
            <div class="btn-group w-100 aparencia-opcoes" role="radiogroup" aria-labelledby="rotulo-fonte" data-campo="fonte">
                @foreach (var o in AparenciaCatalogo.Fontes)
                {
                    <button type="button" class="btn btn-outline-secondary" role="radio" data-valor="@o.Codigo" aria-checked="false" title="@o.Nome">
                        <span class="aparencia-letra aparencia-letra-@o.Codigo" aria-hidden="true">A</span><span class="visually-hidden">@o.Nome</span>
                    </button>
                }
            </div>

            <label class="form-label mt-3" id="rotulo-densidade">Botões e campos</label>
            <div class="btn-group w-100 aparencia-opcoes" role="radiogroup" aria-labelledby="rotulo-densidade" data-campo="densidade">
                @foreach (var o in AparenciaCatalogo.Densidades)
                {
                    <button type="button" class="btn btn-outline-secondary" role="radio" data-valor="@o.Codigo" aria-checked="false">@o.Nome</button>
                }
            </div>

            <div class="form-check form-switch mt-3 d-none d-lg-block">
                <input class="form-check-input" type="checkbox" role="switch" id="aparencia-menu-recolhido" />
                <label class="form-check-label" for="aparencia-menu-recolhido">Menu lateral recolhido (só ícones)</label>
            </div>
        </section>
    </div>
    <div class="offcanvas-footer">
        <button type="button" class="btn btn-outline-secondary" id="aparencia-restaurar">Restaurar padrão</button>
        <button type="button" class="btn btn-primary" id="aparencia-salvar"><i class="bi bi-check2" aria-hidden="true"></i> Salvar</button>
    </div>
</div>
