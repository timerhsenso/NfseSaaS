@{
    ViewData["Title"] = "Contratos";
    // Permissão do Grupo (IAEC), a mesma que a API confere. Antes era o papel
    // antigo do Identity ("Administrador"), que contas criadas pelo cadastro
    // e grupos personalizados não têm — a tela escondia os botões.
    var podeEditar = User.PodeAlterar(NfseSaaS.Application.Authorization.TelaCatalogo.Contratos);
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Contratos cadastrados</span>
        <div class="d-flex align-items-center gap-2">
            <div id="botoes-exportacao-tabela-contratos"></div>
            @if (podeEditar)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-verificar-reajustes" data-requer-empresa
                        title="Calcula agora os reajustes de aniversário pelo índice (o sistema também faz isso todo dia às 10:10)">
                    <i class="bi bi-arrow-repeat"></i> Verificar reajustes
                </button>
                <button type="button" class="btn btn-primary btn-sm" id="btn-novo-contrato" data-requer-empresa>
                    <i class="bi bi-plus-lg"></i> Novo contrato
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <div id="resultado-verificar-reajustes" class="d-none"></div>
        <table id="tabela-contratos" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Descrição</th>
                    <th>Serviços</th>
                    <th>Valor atual</th>
                    <th>Cobrança</th>
                    <th>Status</th>
                    <th>Próximo reajuste</th>
                    <th>Reajuste</th>
                    @if (podeEditar)
                    {
                        <th>Ações</th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (podeEditar)
{
    <div class="modal fade" id="modal-contrato" tabindex="-1" aria-labelledby="titulo-modal-contrato">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <form id="form-contrato" novalidate>
                    <div class="modal-header">
                        <div class="modal-cabecalho-entidade">
                            <div class="entidade-avatar" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></div>
                            <div>
                                <div class="modal-subtitulo" id="cliente-modal-contrato">Novo contrato</div>
                                <h5 class="modal-title" id="titulo-modal-contrato">Novo contrato</h5>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body modal-body-com-resumo">
                        <div class="modal-coluna-principal">
                        <div id="erro-contrato" class="alert alert-danger d-none"></div>
                        <input type="hidden" id="contratoId" />

                        <ul class="nav nav-tabs mb-3" id="tabs-contrato">
                            <li class="nav-item"><button type="button" class="nav-link active" data-tab-alvo="tab-dados"><i class="bi bi-card-text"></i> Dados</button></li>
                            <li class="nav-item"><button type="button" class="nav-link" data-tab-alvo="tab-servico"><i class="bi bi-list-ul"></i> Serviços</button></li>
                            <li class="nav-item"><button type="button" class="nav-link" data-tab-alvo="tab-cobranca"><i class="bi bi-arrow-repeat"></i> Cobrança e reajuste</button></li>
                            <li class="nav-item"><button type="button" class="nav-link" data-tab-alvo="tab-documentos"><i class="bi bi-paperclip"></i> Documentos</button></li>
                            <li class="nav-item"><button type="button" class="nav-link" data-tab-alvo="tab-historico"><i class="bi bi-clock-history"></i> Histórico</button></li>
                        </ul>

                        <div class="tab-conteudo-contrato" data-tab="tab-dados">
                            <div class="mb-3">
                                <label class="form-label">Cliente</label>
                                <select class="form-control" id="clienteId" style="width: 100%" required></select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Descrição do contrato</label>
                                <input type="text" class="form-control" id="descricao" maxlength="200" required placeholder="ex.: Manutenção sistema A" />
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Início do contrato</label>
                                    <input type="date" class="form-control" id="dataInicioContrato" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Fim do contrato</label>
                                    <input type="date" class="form-control" id="dataFim" placeholder="Deixe em branco pra prazo indeterminado" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Observação</label>
                                <textarea class="form-control" id="observacao" maxlength="2000" rows="3" placeholder="opcional"></textarea>
                            </div>
                        </div>

                        <div class="tab-conteudo-contrato d-none" data-tab="tab-servico">
                            <div id="bloco-servicos">
                                <table class="table table-sm align-middle mb-1">
                                    <thead>
                                        <tr>
                                            <th>Serviço</th>
                                            <th style="width:70px">Qtd</th>
                                            <th style="width:110px">Valor unit.</th>
                                            <th style="width:110px" class="text-end">Total</th>
                                            <th style="width:70px" class="text-center" title="Valor muda a cada nota (ex.: horas de suporte). Na Nota Mensal vem o último valor emitido.">Variável <i class="bi bi-info-circle"></i></th>
                                            <th style="width:36px"></th>
                                        </tr>
                                    </thead>
                                </table>
                                <div style="max-height: 210px; overflow-y: auto;">
                                    <table class="table table-sm align-middle mb-0">
                                        <tbody id="linhas-servico-contrato"></tbody>
                                    </table>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary mt-1" id="btn-add-linha-servico">
                                    <i class="bi bi-plus-lg"></i> Adicionar serviço
                                </button>
                                <div class="form-text" id="nota-servicos-nao-editaveis"></div>
                                @* Só na edição: quando as linhas mudam, a mudança vira um evento do Histórico de valores. *@
                                <div id="bloco-mudanca-servicos" class="border rounded p-2 mt-2 d-none">
                                    <div class="small fw-semibold mb-2">Se você alterou os serviços acima, informe:</div>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label small mb-1" for="mudanca-tipo">Tipo da mudança</label>
                                            <select class="form-select form-select-sm" id="mudanca-tipo">
                                                <option value="3">Alteração de escopo (aditivo)</option>
                                                <option value="2">Reajuste</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small mb-1" for="mudanca-vigencia">Vale a partir de</label>
                                            <input type="date" class="form-control form-control-sm" id="mudanca-vigencia" />
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label small mb-1" for="mudanca-motivo">Motivo</label>
                                            <input type="text" class="form-control form-control-sm" id="mudanca-motivo" maxlength="500" placeholder="Ex.: inclusão do módulo X" />
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end mt-1"><strong>Total: <span id="valorAtualCalculado">R$ 0,00</span></strong></div>
                            </div>
                        </div>

                        <div class="tab-conteudo-contrato d-none" data-tab="tab-cobranca">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Tipo de cobrança</label>
                                    <select class="form-select" id="tipoCobranca">
                                        <option value="0">Avulso</option>
                                        <option value="1">Mensal</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3" id="bloco-status">
                                    <label class="form-label">Status</label>
                                    <select class="form-select" id="status">
                                        <option value="0">Rascunho</option>
                                        <option value="1">Ativo</option>
                                        <option value="2">Suspenso</option>
                                        <option value="3">Encerrado</option>
                                        <option value="4">Cancelado</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Periodicidade de reajuste (meses)</label>
                                    <input type="number" min="1" max="60" class="form-control" id="periodicidadeReajusteMeses" value="12" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Índice de reajuste</label>
                                    <select class="form-select" id="indiceReajuste">
                                        <option value="">Não definido</option>
                                        <option value="0">IPCA</option>
                                        <option value="1">IGPM</option>
                                        <option value="2">INCC</option>
                                        <option value="3">INPC</option>
                                        <option value="4">SELIC</option>
                                        <option value="5">CDI</option>
                                        <option value="99">Outro</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Alertar com quantos dias de antecedência</label>
                                    <input type="number" min="1" class="form-control" id="diasAlertaOverride" placeholder="Deixe em branco pra usar o padrão da empresa" />
                                </div>
                                <div class="col-md-6 mb-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="permitirAlterarValorNaEmissao" checked />
                                        <label class="form-check-label" for="permitirAlterarValorNaEmissao">Permitir alterar valor na emissão em lote</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 mb-3">
                                    <label class="form-label" for="localPrestacaoContrato">Local da prestação das notas</label>
                                    <select class="form-select" id="localPrestacaoContrato"><option></option></select>
                                    <div class="form-text">Em branco, as notas vão com o município da empresa. Use quando o serviço é feito no cliente, em outro município. Dá para trocar em cada nota.</div>
                                </div>
                            </div>
                            <div class="row" id="bloco-reajuste-automatico">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="reajusteAutomatico">No aniversário, o reajuste pelo índice</label>
                                    <select class="form-select" id="reajusteAutomatico">
                                        <option value="">Segue o padrão da empresa</option>
                                        <option value="true">É aplicado automaticamente</option>
                                        <option value="false">Aguarda minha aprovação</option>
                                    </select>
                                    <div class="form-text">Com aprovação, dá pra aplicar o índice, negociar outro valor ou não reajustar.</div>
                                </div>
                                <div class="col-md-6 mb-3 d-flex align-items-start pt-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="aplicarIndiceNegativo" />
                                        <label class="form-check-label" for="aplicarIndiceNegativo">Índice negativo reduz o valor</label>
                                        <div class="form-text">Desmarcado (padrão): com deflação no período, o valor é mantido.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-conteudo-contrato d-none" data-tab="tab-documentos">
                            <div id="documentos-indisponivel" class="text-muted small">Salve o contrato primeiro pra poder anexar documentos.</div>
                            <div id="documentos-disponivel" class="d-none">
                                <div class="input-group mb-2">
                                    <input type="file" class="form-control" id="documento-arquivo" accept=".pdf,.doc,.docx" />
                                    <button type="button" class="btn btn-outline-secondary" id="btn-upload-documento">
                                        <i class="bi bi-upload"></i> Anexar
                                    </button>
                                </div>
                                <div class="form-text">.pdf, .doc ou .docx, até 10 MB.</div>
                                <table class="table table-sm table-striped mt-2">
                                    <thead>
                                        <tr><th>Arquivo</th><th>Tamanho</th><th>Enviado em</th><th style="width:80px"></th></tr>
                                    </thead>
                                    <tbody id="lista-documentos-contrato"></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="tab-conteudo-contrato d-none" data-tab="tab-historico">
                            <div id="historico-indisponivel" class="text-muted small">O histórico aparece depois que o contrato é salvo.</div>
                            <table class="table table-sm table-striped d-none" id="tabela-historico-contrato">
                                <thead>
                                    <tr><th>Data</th><th>Origem</th><th>Descrição</th></tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        </div>

                        @* Resumo fixo à direita — só em edição (preenchido por renderizarResumoContrato em contratos.js). *@
                        <aside class="modal-resumo d-none" id="resumo-contrato" aria-label="Resumo do contrato">
                            <div>
                                <div class="resumo-rotulo">Valor mensal</div>
                                <div class="resumo-valor" id="resumo-valor-contrato">—</div>
                                <div class="resumo-detalhe" id="resumo-detalhe-contrato"></div>
                            </div>
                            <div class="resumo-alerta d-none" id="resumo-pendente-contrato"></div>
                            <dl class="resumo-lista">
                                <dt>Situação</dt><dd id="resumo-situacao-contrato">—</dd>
                                <dt>Próximo reajuste</dt><dd id="resumo-proximo-contrato">—</dd>
                                <dt>Índice</dt><dd id="resumo-indice-contrato">—</dd>
                                <dt>Último reajuste</dt><dd id="resumo-ultimo-contrato">—</dd>
                                <dt>No aniversário</dt><dd id="resumo-aprovacao-contrato">—</dd>
                            </dl>
                        </aside>
                    </div>
                    <div class="modal-footer">
                        <span class="modal-rodape-info">Campos com <span class="text-danger">*</span> são obrigatórios</span>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal-historico-reajuste" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="titulo-modal-historico">Histórico de valores</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="erro-reajuste" class="alert alert-danger d-none"></div>

                    <div id="painel-reajuste-pendente" class="border border-warning rounded p-3 mb-4 d-none">
                        <h6 class="mb-2"><i class="bi bi-hourglass-split"></i> Reajuste do aniversário aguardando aprovação</h6>
                        <div id="pendente-resumo" class="mb-1"></div>
                        <div id="pendente-janela" class="small text-muted mb-3"></div>
                        <div id="erro-decisao-reajuste" class="alert alert-danger d-none"></div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-success btn-sm" id="btn-aplicar-calculado">
                                <i class="bi bi-check2"></i> Aplicar <span id="pendente-percentual-botao"></span>
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btn-mostrar-negociar">
                                <i class="bi bi-chat-left-text"></i> Negociar outro valor
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" id="btn-mostrar-recusar">
                                <i class="bi bi-x-lg"></i> Não reajustar
                            </button>
                        </div>
                        <div id="bloco-negociar" class="mt-3 d-none">
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <label class="form-label small mb-1" for="negociado-percentual">% acordado</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" id="negociado-percentual" />
                                </div>
                                <div class="col-md-4 mb-2">
                                    <label class="form-label small mb-1" for="negociado-valor">ou valor novo</label>
                                    <input type="number" step="0.01" min="0.01" class="form-control form-control-sm" id="negociado-valor" />
                                </div>
                            </div>
                            <label class="form-label small mb-1" for="negociado-motivo">Motivo</label>
                            <input type="text" maxlength="500" class="form-control form-control-sm mb-2" id="negociado-motivo" placeholder="ex.: cliente pediu redução, acordado 3%" />
                            <button type="button" class="btn btn-primary btn-sm" id="btn-confirmar-negociado">Aplicar valor negociado</button>
                        </div>
                        <div id="bloco-recusar" class="mt-3 d-none">
                            <label class="form-label small mb-1" for="recusa-motivo">Motivo</label>
                            <input type="text" maxlength="500" class="form-control form-control-sm mb-2" id="recusa-motivo" placeholder="ex.: cliente não aceitou; mantido o valor até o próximo aniversário" />
                            <button type="button" class="btn btn-danger btn-sm" id="btn-confirmar-recusa">Confirmar: não reajustar neste ciclo</button>
                        </div>
                    </div>

                    <form id="form-reajuste" class="border rounded p-3 mb-4">
                        <input type="hidden" id="reajuste-contratoId" />
                        <h6 class="text-muted">Registrar novo reajuste</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label" for="reajuste-dataReajuste">Data do reajuste</label>
                                <input type="date" class="form-control" id="reajuste-dataReajuste" required />
                                <div class="form-text" id="reajuste-dica-data"></div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label" for="reajuste-indiceUsado">Índice usado</label>
                                <select class="form-select" id="reajuste-indiceUsado">
                                    <option value="">Não definido</option>
                                    <option value="0">IPCA</option>
                                    <option value="1">IGPM</option>
                                    <option value="2">INCC</option>
                                    <option value="3">INPC</option>
                                    <option value="4">SELIC</option>
                                    <option value="5">CDI</option>
                                    <option value="99">Outro</option>
                                </select>
                            </div>
                        </div>

                        @* Simulação pelo índice: recalcula sozinha ao abrir e ao trocar data/índice (contratos.js › simularReajuste). *@
                        <div id="reajuste-sugestao" class="mb-3" aria-live="polite"></div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label" for="reajuste-valorNovo">Valor novo</label>
                                <input type="number" step="0.01" min="0.01" class="form-control" id="reajuste-valorNovo" required />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label" for="reajuste-percentual">% aplicado</label>
                                <input type="number" step="0.0001" class="form-control" id="reajuste-percentual" placeholder="calculado ou digite" />
                            </div>
                            <div class="col-md-5 mb-3">
                                <label class="form-label" for="reajuste-observacao">Observação</label>
                                <input type="text" class="form-control" id="reajuste-observacao" maxlength="500" placeholder="opcional" />
                            </div>
                        </div>
                        <div class="form-text mb-2 d-none" id="reajuste-dica-variavel"></div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary btn-sm">Registrar reajuste</button>
                        </div>
                    </form>

                    <h6 class="text-muted">Histórico de valores</h6>
                    <div class="form-text mb-2">Valor inicial, reajustes e alterações de escopo do contrato, do mais recente para o mais antigo. Abaixo de cada evento, os serviços cobrados a partir dele.</div>
                    <table class="table table-sm table-striped" id="tabela-historico-reajuste">
                        <thead>
                            <tr>
                                <th>Vigência</th>
                                <th>Tipo</th>
                                <th class="text-end">Valor anterior</th>
                                <th class="text-end">Valor novo</th>
                                <th class="text-end">%</th>
                                <th>Índice</th>
                                <th>Motivo</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/paginas/contratos.js" asp-append-version="true"></script>
}
