@{
    ViewData["Title"] = "Contratos";
    var podeEditar = User.IsInRole("Administrador");
}

<div class="card mb-3">
    <div class="card-body">
        <label class="form-label">Empresa</label>
        <select id="seletor-empresa" class="form-select"></select>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Contratos cadastrados</span>
        <div class="d-flex align-items-center gap-2">
            <div id="botoes-exportacao-tabela-contratos"></div>
            @if (podeEditar)
            {
                <button type="button" class="btn btn-primary btn-sm" id="btn-novo-contrato">
                    <i class="bi bi-plus-lg"></i> Novo contrato
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table id="tabela-contratos" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Descrição</th>
                    <th>Serviço</th>
                    <th>Valor atual</th>
                    <th>Próximo reajuste</th>
                    <th>Reajuste</th>
                    <th>Situação</th>
                    @if (podeEditar)
                    {
                        <th>Ações</th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (podeEditar)
{
    <div class="modal fade" id="modal-contrato" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="form-contrato">
                    <div class="modal-header">
                        <h5 class="modal-title" id="titulo-modal-contrato">Novo contrato</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="erro-contrato" class="alert alert-danger d-none"></div>
                        <input type="hidden" id="contratoId" />

                        <div class="mb-3">
                            <label class="form-label">Cliente</label>
                            <select class="form-select" id="clienteId" required></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Serviço (classificação fiscal)</label>
                            <select class="form-select" id="servicoId" required></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descrição do contrato</label>
                            <input type="text" class="form-control" id="descricao" maxlength="200" required placeholder="ex.: Manutenção sistema A" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Valor atual</label>
                            <input type="number" step="0.01" min="0.01" class="form-control" id="valorAtual" required />
                            <div class="form-text" id="nota-valor-nao-editavel"></div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Início do contrato</label>
                                <input type="date" class="form-control" id="dataInicioContrato" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Periodicidade de reajuste (meses)</label>
                                <input type="number" min="1" max="60" class="form-control" id="periodicidadeReajusteMeses" value="12" required />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Índice de reajuste</label>
                                <input type="text" class="form-control" id="indiceReajuste" maxlength="30" placeholder="ex.: IPCA, IGPM (opcional)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Alertar com quantos dias de antecedência</label>
                                <input type="number" min="1" class="form-control" id="diasAlertaOverride" placeholder="Deixe em branco pra usar o padrão da empresa" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal-historico-reajuste" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="titulo-modal-historico">Histórico de reajustes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="erro-reajuste" class="alert alert-danger d-none"></div>

                    <form id="form-reajuste" class="border rounded p-3 mb-4">
                        <input type="hidden" id="reajuste-contratoId" />
                        <h6 class="text-muted">Registrar novo reajuste</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Data do reajuste</label>
                                <input type="date" class="form-control" id="reajuste-dataReajuste" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Valor novo</label>
                                <input type="number" step="0.01" min="0.01" class="form-control" id="reajuste-valorNovo" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">% aplicado</label>
                                <input type="number" step="0.01" class="form-control" id="reajuste-percentual" placeholder="calculado ou digite" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Índice usado</label>
                                <input type="text" class="form-control" id="reajuste-indiceUsado" maxlength="30" placeholder="opcional" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Observação</label>
                                <input type="text" class="form-control" id="reajuste-observacao" maxlength="500" placeholder="opcional" />
                            </div>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary btn-sm">Registrar reajuste</button>
                        </div>
                    </form>

                    <h6 class="text-muted">Histórico</h6>
                    <table class="table table-sm table-striped" id="tabela-historico-reajuste">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Valor anterior</th>
                                <th>Valor novo</th>
                                <th>% aplicado</th>
                                <th>Índice</th>
                                <th>Observação</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/empresa-seletor.js"></script>
    <script src="~/js/paginas/contratos.js" asp-append-version="true"></script>
}
