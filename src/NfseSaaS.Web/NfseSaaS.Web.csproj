<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>NfseSaaS.Web</RootNamespace>
		<UserSecretsId>e6f6e7a2-6b0a-4c9a-9c9a-nfsesaas-web</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\NfseSaaS.Application\NfseSaaS.Application.csproj" />
		<ProjectReference Include="..\NfseSaaS.Infrastructure\NfseSaaS.Infrastructure.csproj" />
		<ProjectReference Include="..\NfseSaaS.Nacional\NfseSaaS.Nacional.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
		<!-- Exigido pela ferramenta "dotnet ef" no projeto de inicialização,
         mesmo o DbContext estando em NfseSaaS.Infrastructure. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>