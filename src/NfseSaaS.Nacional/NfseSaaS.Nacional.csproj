<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NfseSaaS.Nacional</RootNamespace>
  </PropertyGroup>

  <!--
    Integração fiscal com o Sistema Nacional da NFS-e.
    Isolado de propósito: não referencia Domain, Application, EF Core ou ASP.NET.
    Mesma dependência de assinatura XML-DSig já validada na POC.
  -->
  <ItemGroup>
    <!-- Mesma versão do runtime (.NET 10): traz as correções de segurança da linha 10.0 (antes 8.0.5, aviso NU1903). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <!-- Referência direta: o Xml 10.0.14 ainda resolve o Pkcs 10.0.0, que tem as falhas GHSA-846f-f764-76mx e GHSA-2fmv-rv2c-59x7 (avisos NU1902/NU1903). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
  </ItemGroup>

</Project>
