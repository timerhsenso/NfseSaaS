<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NfseSaaS.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NfseSaaS.Domain\NfseSaaS.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <!-- Catálogo oficial de rejeições da SEFIN (gerado por tools/rejeicoes-sefin/gerar_catalogo.py). -->
  <ItemGroup>
    <EmbeddedResource Include="Rejeicoes\rejeicoes-sefin.json" LogicalName="NfseSaaS.Application.Rejeicoes.rejeicoes-sefin.json" />
    <!-- Anexos VII e VIII da Reforma Tributária na NFS-e (gerado por tools/ibscbs/gerar_correlacao.py). -->
    <EmbeddedResource Include="Fiscal\IbsCbs\correlacao-ibscbs.json" LogicalName="NfseSaaS.Application.Fiscal.IbsCbs.correlacao-ibscbs.json" />
    <!-- JUR1: textos dos instrumentos legais (DPA e autorizações), um arquivo por versão; o aceite guarda o SHA-256 deste texto. -->
    <EmbeddedResource Include="Legal\Textos\*.html" LogicalName="NfseSaaS.Application.Legal.Textos.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Não deve conhecer EF Core, PostgreSQL ou detalhes de infraestrutura. -->

</Project>
