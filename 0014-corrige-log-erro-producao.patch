@@ -0,0 +1,18 @@
+@model NfseSaaS.Web.Controllers.ErrorViewModel
+@{
+    ViewData["Title"] = "Erro";
+    Layout = "_AuthLayout";
+}
+
+<div class="text-center py-3">
+    <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
+    <h4 class="mt-3">Ocorreu um erro ao processar sua solicitação</h4>
+    <p class="text-muted">
+        Já registramos os detalhes técnicos. Se o problema continuar, informe o código
+        abaixo ao suporte.
+    </p>
+    <p>
+        <code>@Model.CorrelationId</code>
+    </p>
+    <a href="/" class="btn btn-primary">Voltar ao início</a>
+</div>
